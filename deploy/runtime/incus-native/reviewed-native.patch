+++ b/internal/server/db/cluster/guard_caller_pending_test.go
@@ -0,0 +1,104 @@
+package cluster
+
+// Transaction composition at the actual native mapper boundary, not execution
+// of CreateInternal, driver initialization, or a physical callback.
+import (
+	"context"
+	"database/sql"
+	"testing"
+	"time"
+)
+
+func TestGuardNativeCallerConfigDeviceProfileTransaction(t *testing.T) {
+	for _, failConfig := range []bool{true, false} {
+		name := "success"
+		if failConfig {
+			name = "late-config-failure"
+		}
+		t.Run(name, func(t *testing.T) {
+			db := guardFixture(t)
+			guardEnableFixture(t, db)
+			ctx := context.Background()
+			if _, err := db.Exec(`INSERT INTO nodes(id,name,description,address,schema,api_extensions,arch) VALUES(999,'fixture','','fixture',73,1,1); INSERT INTO profiles(name,description,project_id) VALUES('default','',1)`); err != nil {
+				t.Fatal(err)
+			}
+			statements, err := PrepareStmts(db, false)
+			if err != nil {
+				t.Fatal(err)
+			}
+			old := PreparedStmts
+			PreparedStmts = statements
+			defer func() {
+				PreparedStmts = old
+				for _, stmt := range statements {
+					if stmt != nil {
+						stmt.Close()
+					}
+				}
+			}()
+			if err = guardTx(db, func(tx *sql.Tx) error {
+				if err := guardBound(tx, "caller"); err != nil {
+					return err
+				}
+				return guardReserveCreate(ctx, tx, "caller", "fixture", 1, 999, "caller")
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if failConfig {
+				if _, err = db.Exec(`CREATE TRIGGER fail_guard_config BEFORE INSERT ON instances_config BEGIN SELECT RAISE(ABORT,'fixture late config failure'); END`); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var id int64
+			var token string
+			// This mirrors the non-snapshot mapper sequence in CreateInternal. It
+			// deliberately does not copy the complete function or claim caller coverage.
+			err = guardTx(db, func(tx *sql.Tx) error {
+				var err error
+				id, token, err = guardCreateMappedRow(ctx, tx, "caller", "fixture", Instance{Project: "default", Name: "caller", Node: "fixture", Architecture: 1, CreationDate: time.Unix(100, 0)})
+				if err != nil {
+					return err
+				}
+				if err = CreateInstanceDevices(ctx, tx, id, map[string]Device{"root": {Name: "root", Type: TypeDisk, Config: map[string]string{"path": "/", "pool": "guard-fixture"}}}); err != nil {
+					return err
+				}
+				if err = CreateInstanceConfig(ctx, tx, id, map[string]string{"limits.memory": "512MiB"}); err != nil {
+					return err
+				}
+				return UpdateInstanceProfiles(ctx, tx, int(id), "default", []string{"default"})
+			})
+			if failConfig {
+				if err == nil {
+					t.Fatal("injected late config error ignored")
+				}
+				for _, table := range []string{"instances", "instances_devices", "instances_config", "instances_profiles", "guard_row_history", "guard_storage_attempts"} {
+					var n int
+					if err = db.QueryRow(`SELECT count(*) FROM ` + table).Scan(&n); err != nil || n != 0 {
+						t.Fatal("partial mapper transaction", table, n, err)
+					}
+				}
+				var n int
+				if err = db.QueryRow(`SELECT count(*) FROM guard_create_scopes`).Scan(&n); err != nil || n != 1 {
+					t.Fatal("earlier retained reservation lost", n, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			var n int
+			for _, table := range []string{"instances_devices", "instances_config", "instances_profiles", "guard_row_history"} {
+				if err = db.QueryRow(`SELECT count(*) FROM ` + table).Scan(&n); err != nil || n != 1 {
+					t.Fatal(table, n, err)
+				}
+			}
+			// Only a successful OUTER transaction reaches a new attempt transaction.
+			if err = guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "caller", "fixture", token) }); err != nil {
+				t.Fatal(err)
+			}
+			if err = db.QueryRow(`SELECT count(*) FROM guard_storage_attempts WHERE observed_return IS NULL`).Scan(&n); err != nil || n != 1 {
+				t.Fatal(n, err)
+			}
+		})
+	}
+}
diff --git a/internal/server/db/cluster/guard_mapper_pending.go b/internal/server/db/cluster/guard_mapper_pending.go
new file mode 100644
index 000000000..cf795a015
--- /dev/null
+++ b/internal/server/db/cluster/guard_mapper_pending.go
@@ -0,0 +1,63 @@
+package cluster
+
+import (
+	"context"
+	"crypto/rand"
+	"database/sql"
+	"encoding/hex"
+)
+
+// guardCreateMappedRow is a dormant native mapper insertion candidate, not an
+// admission-to-I/O bridge. It supports only a non-snapshot/non-ephemeral empty
+// container row. No daemon caller exists. Source type/policy is not represented
+// by Instance, so the missing native capability remains an activation blocker.
+func guardCreateMappedRow(ctx context.Context, tx *sql.Tx, request, principal string, object Instance) (id int64, token string, err error) {
+	if object.Type != 0 || object.Snapshot || object.Ephemeral || object.Stateful {
+		return 0, "", errGuardDenied
+	}
+	var scope int64
+	err = tx.QueryRowContext(ctx, `SELECT s.project_id FROM guard_create_scopes s JOIN projects p ON p.id=s.project_id JOIN guard_envelopes e ON e.id=s.request_id JOIN guard_epoch g ON g.id=1 AND g.epoch=e.epoch
+ WHERE s.request_id=? AND e.principal=? AND e.state='bound' AND g.sealed=0 AND p.name=? AND s.name=?
+ AND NOT EXISTS(SELECT 1 FROM guard_row_history WHERE request_id=s.request_id)`, request, principal, object.Project, object.Name).Scan(&scope)
+	if err != nil {
+		return 0, "", err
+	}
+	bytes := make([]byte, 32)
+	if _, err = rand.Read(bytes); err != nil {
+		return 0, "", err
+	}
+	token = hex.EncodeToString(bytes)
+	if _, err = tx.ExecContext(ctx, `SAVEPOINT guard_mapped_row`); err != nil {
+		return 0, "", err
+	}
+	defer func() {
+		if err != nil {
+			_, rollbackErr := tx.ExecContext(context.Background(), `ROLLBACK TO guard_mapped_row`)
+			if rollbackErr != nil {
+				err = rollbackErr
+			}
+			id = 0
+			token = ""
+		}
+		_, releaseErr := tx.ExecContext(context.Background(), `RELEASE guard_mapped_row`)
+		if releaseErr != nil {
+			err = releaseErr
+			id = 0
+			token = ""
+		}
+	}()
+	id, err = CreateInstance(ctx, tx, object)
+	if err != nil {
+		return 0, "", err
+	}
+	var r sql.Result
+	r, err = tx.ExecContext(ctx, `UPDATE instances SET guard_token=? WHERE id=? AND project_id=? AND name=? AND guard_token IS NULL`, token, id, scope, object.Name)
+	if err = guardChanged(r, err); err != nil {
+		return 0, "", err
+	}
+	r, err = tx.ExecContext(ctx, `INSERT INTO guard_row_history(request_id,native_id,token,project_id,name) VALUES(?,?,?,?,?)`, request, id, token, scope, object.Name)
+	if err = guardChanged(r, err); err != nil {
+		return 0, "", err
+	}
+	return id, token, nil
+}
diff --git a/internal/server/db/cluster/guard_mapper_pending_test.go b/internal/server/db/cluster/guard_mapper_pending_test.go
