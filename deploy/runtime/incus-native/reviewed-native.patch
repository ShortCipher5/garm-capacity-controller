+// Test-only transplant of pinned upstream empty-create orchestration.
+// Only signature and two dependency calls are adapted; no actual Incus daemon,
+// storage backend, cgroup, cowsql or privileges are exercised.
+package nativefrontier
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"github.com/lxc/incus/v6/shared/revert"
+	"go/format"
+	"os"
+	"strings"
+	"testing"
+)
+
+func pinnedEmptyCreate(h *nativeHarness) (*fakeInstance, error) {
+	revert := revert.New()
+	defer revert.Fail()
+
+	// Create the instance record.
+	inst, instOp, cleanup, err := h.createInternal()
+	if err != nil {
+		return nil, fmt.Errorf("Failed creating instance record: %w", err)
+	}
+
+	revert.Add(cleanup)
+	defer instOp.Done(err)
+
+	pool, err := h.loadPool(inst)
+	if err != nil {
+		return nil, fmt.Errorf("Failed loading instance storage pool: %w", err)
+	}
+
+	err = pool.CreateInstance(inst, nil)
+	if err != nil {
+		return nil, fmt.Errorf("Failed creating instance: %w", err)
+	}
+
+	revert.Add(func() { _ = inst.Delete(true) })
+
+	err = inst.UpdateBackupFile()
+	if err != nil {
+		return nil, err
+	}
+
+	revert.Success()
+	return inst, nil
+}
+
+type nativeHarness struct {
+	row, physical                                                     bool
+	journalUnavailable, loseStorageACK, backupFailure, cleanupFailure bool
+	attempts, deletes                                                 int
+	operationDone                                                     error
+}
+type fakeInstance struct{ h *nativeHarness }
+type fakeOperation struct{ h *nativeHarness }
+type fakePool struct{ h *nativeHarness }
+
+func (h *nativeHarness) createInternal() (*fakeInstance, *fakeOperation, revert.Hook, error) {
+	h.row = true
+	return &fakeInstance{h}, &fakeOperation{h}, func() { h.row = false }, nil
+}
+func (h *nativeHarness) loadPool(_ *fakeInstance) (*fakePool, error) { return &fakePool{h}, nil }
+func (o *fakeOperation) Done(err error)                              { o.h.operationDone = err }
+func (p *fakePool) CreateInstance(_ *fakeInstance, op any) error {
+	if op != nil {
+		return errors.New("unexpected non-nil operation propagation")
+	}
+	// Proposed BEFORE-native-I/O journal boundary, represented by a fixture.
+	if p.h.journalUnavailable {
+		return errors.New("intent persistence failed")
+	}
+	p.h.attempts++
+	p.h.physical = true
+	if p.h.loseStorageACK {
+		return errors.New("storage outcome unknown")
+	}
+	return nil
+}
+func (i *fakeInstance) UpdateBackupFile() error {
+	if i.h.backupFailure {
+		return errors.New("backup failure")
+	}
+	return nil
+}
+func (i *fakeInstance) Delete(force bool) error {
+	i.h.deletes++
+	if !force {
+		return errors.New("expected upstream force cleanup")
+	}
+	if i.h.cleanupFailure {
+		return errors.New("cleanup incomplete")
+	}
+	i.h.physical = false
+	return nil
+}
+func TestPinnedEmptyCreateBodyIdentity(t *testing.T) {
+	raw, err := os.ReadFile("../../cmd/incusd/instance.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fmt.Sprintf("%x", sha256.Sum256(raw)) != "a0869997881bf2475cecc9f1436dd90ed3d373e9b74a57d1dfeeb651191c474c" {
+		t.Fatal("pinned source changed")
+	}
+	src := string(raw)
+	part := src[strings.Index(src, "func instanceCreateAsEmpty("):strings.Index(src, "// instanceImageTransfer")]
+	body := strings.TrimSpace(part[strings.Index(part, "{"):])
+	body = strings.ReplaceAll(body, "instance.CreateInternal(s, args, op, true, true)", "h.createInternal()")
+	body = strings.ReplaceAll(body, "storagePools.LoadByInstance(s, inst)", "h.loadPool(inst)")
+	expected, err := format.Source([]byte("package nativefrontier\nfunc pinnedEmptyCreate(h *nativeHarness) (*fakeInstance, error) " + body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, err := os.ReadFile("empty_path_test.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := strings.Index(string(own), "func pinnedEmptyCreate(")
+	b := strings.Index(string(own), "type nativeHarness struct")
+	actual, err := format.Source([]byte("package nativefrontier\n" + string(own)[a:b]))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(actual) != string(expected) {
+		t.Fatal("transplanted upstream control flow changed")
+	}
+}
+func TestNativeJournalFailureStopsStorageBeforeAttempt(t *testing.T) {
+	h := &nativeHarness{journalUnavailable: true}
+	_, err := pinnedEmptyCreate(h)
+	if err == nil || h.physical || h.attempts != 0 || h.row {
+		t.Fatal("failed before-I/O intent did not fail closed", h, err)
+	}
+}
+func TestNativeLostStorageACKLeavesPhysicalDespiteNoRow(t *testing.T) {
+	h := &nativeHarness{loseStorageACK: true}
+	_, err := pinnedEmptyCreate(h)
+	if err == nil || !h.physical || h.row || h.attempts != 1 || h.deletes != 0 {
+		t.Fatal("lost ACK counterexample disappeared", h, err)
+	}
+	// Deferred Done(err) captured the earlier nil, not later storage error.
+	// An operation-lock Done callback is therefore not physical terminal proof.
+	if h.operationDone != nil {
+		t.Fatal("pinned defer behavior changed")
+	}
+}
+func TestNativeIgnoredCleanupFailureLeavesPhysicalDespiteNoRow(t *testing.T) {
+	h := &nativeHarness{backupFailure: true, cleanupFailure: true}
+	_, err := pinnedEmptyCreate(h)
+	if err == nil || !h.physical || h.row || h.deletes != 1 {
+		t.Fatal("revert counterexample disappeared", h, err)
+	}
+	if err.Error() != "backup failure" {
+		t.Fatal("upstream cleanup failure unexpectedly propagated", err)
+	}
+}
+func TestNativeSuccessStillOwnsPhysicalAllocation(t *testing.T) {
+	h := &nativeHarness{}
+	_, err := pinnedEmptyCreate(h)
+	if err != nil || !h.physical || !h.row || h.deletes != 0 {
+		t.Fatal("native creation mismatch", h, err)
+	}
+}
