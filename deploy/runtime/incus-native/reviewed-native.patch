+# Build via run.sh only, which requires an official Debian image pinned by digest.
+ARG BASE_IMAGE
+FROM ${BASE_IMAGE}
+ARG DEBIAN_FRONTEND=noninteractive
+ENV GOTOOLCHAIN=local
+RUN . /etc/os-release && test "$ID" = debian && test "$VERSION_ID" = 13 \
+ && apt-get update && apt-get install --no-install-recommends -y \
+    ca-certificates gcc g++ make pkg-config golang-go \
+    libacl1-dev libcap-dev libdbus-1-dev libcowsql-dev liblxc-dev \
+    libseccomp-dev libselinux1-dev libsqlite3-dev libudev-dev \
+ && dpkg-query -W -f='${Package}\t${Version}\n' | sort > /native-package-versions.tsv \
+ && rm -rf /var/lib/apt/lists/*
+# No lxc/incus service, daemon binary, Docker socket or host directory is mounted.
+WORKDIR /src
+COPY . /src
+RUN test "$(cat qualification/nativebuild/INCUS_SOURCE_REVISION)" = a99413afd0c742da3bba10eb4f75d639f9dbbd32 \
+ && go mod verify \
+ && go mod download \
+ && go mod verify \
+ && mkdir /out \
+ && cp /native-package-versions.tsv /out/ \
+ && go version > /out/go-version.txt \
+ && go env > /out/go-env.txt \
+ && go test -c -o /out/incusd-compile-only.test ./cmd/incusd \
+ && go test -race -count=3 ./qualification/nativefrontier \
+ && go vet ./qualification/nativefrontier
+# Only the already-reviewed nonprivileged fixture tests are executable at runtime.
+# Never run incusd-compile-only.test or incusd; full daemon validation is not covered.
+ENTRYPOINT ["/bin/true"]
