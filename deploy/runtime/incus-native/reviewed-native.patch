index 000000000..7799baf13
--- /dev/null
+++ b/internal/server/db/cluster/guard_row_pending.go
@@ -0,0 +1,57 @@
+package cluster
+
+// Non-activatable native-table candidate. No CreateInternal/driver callers.
+import (
+	"context"
+	"crypto/rand"
+	"database/sql"
+	"encoding/hex"
+)
+
+// guardCreateRow inserts a deliberately narrow empty, non-ephemeral container
+// row AND history itself. It cannot adopt a pre-existing row. The caller MUST
+// roll back its transaction on any error (as for native mapper operations).
+// This does not execute the full upstream CreateInternal/config/device path.
+func guardCreateRow(ctx context.Context, tx *sql.Tx, request, principal string, node, architecture int64) (int64, string, error) {
+	b := make([]byte, 32)
+	if _, err := rand.Read(b); err != nil {
+		return 0, "", err
+	}
+	token := hex.EncodeToString(b)
+	r, err := tx.ExecContext(ctx, `INSERT INTO instances(node_id,name,architecture,type,ephemeral,description,project_id,guard_token)
+ SELECT ?,s.name,?,0,0,'',s.project_id,? FROM guard_create_scopes s JOIN guard_envelopes e ON e.id=s.request_id JOIN guard_epoch g ON g.id=1 AND g.epoch=e.epoch
+ WHERE s.request_id=? AND e.principal=? AND e.state='bound' AND g.sealed=0
+ AND NOT EXISTS(SELECT 1 FROM guard_row_history WHERE request_id=s.request_id)`, node, architecture, token, request, principal)
+	if err = guardChanged(r, err); err != nil {
+		return 0, "", err
+	}
+	id, err := r.LastInsertId()
+	if err != nil {
+		return 0, "", err
+	}
+	r, err = tx.ExecContext(ctx, `INSERT INTO guard_row_history(request_id,native_id,token,project_id,name) SELECT ?,id,guard_token,project_id,name FROM instances WHERE id=? AND guard_token=?`, request, id, token)
+	if err = guardChanged(r, err); err != nil {
+		return 0, "", err
+	}
+	return id, token, nil
+}
+
+// A committed attempt is NEVER an instruction to retry. The caller may call
+// native I/O only on a known-success commit in the SAME execution, with native
+// reservation/locking still held. Those locks/dispatchers are not implemented.
+func guardBeginStorage(ctx context.Context, tx *sql.Tx, request, principal, token string) error {
+	r, err := tx.ExecContext(ctx, `INSERT INTO guard_storage_attempts(request_id,token,effect)
+ SELECT h.request_id,h.token,'create_storage' FROM guard_row_history h
+ JOIN instances i ON i.id=h.native_id AND i.guard_token=h.token AND i.project_id=h.project_id AND i.name=h.name
+ JOIN guard_create_scopes s ON s.request_id=h.request_id AND s.project_id=h.project_id AND s.name=h.name
+ JOIN guard_envelopes e ON e.id=h.request_id JOIN guard_epoch g ON g.id=1 AND g.epoch=e.epoch
+ WHERE h.request_id=? AND e.principal=? AND h.token=? AND e.state='bound' AND g.sealed=0`, request, principal, token)
+	return guardChanged(r, err)
+}
+func guardRecordStorageReturn(ctx context.Context, tx *sql.Tx, request, token, result string) error {
+	if result != "success" && result != "error" {
+		return errGuardDenied
+	}
+	r, err := tx.ExecContext(ctx, `UPDATE guard_storage_attempts SET observed_return=? WHERE request_id=? AND token=? AND observed_return IS NULL`, result, request, token)
+	return guardChanged(r, err)
+}
