@@ -0,0 +1,112 @@
+package cluster
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestGuardActualMapperAtomicBinding(t *testing.T) {
+	db := guardFixture(t)
+	guardEnableFixture(t, db)
+	ctx := context.Background()
+	if _, err := db.Exec(`INSERT INTO nodes(id,name,description,address,schema,api_extensions,arch) VALUES(999,'fixture','','fixture',73,1,1)`); err != nil {
+		t.Fatal(err)
+	}
+	// Same generated prepared statement and mapper used by native CreateInternal.
+	text, err := StmtString(instanceCreate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stmt, err := db.Prepare(text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stmt.Close()
+	old, had := PreparedStmts[instanceCreate]
+	PreparedStmts[instanceCreate] = stmt
+	defer func() {
+		if had {
+			PreparedStmts[instanceCreate] = old
+		} else {
+			delete(PreparedStmts, instanceCreate)
+		}
+	}()
+	object := Instance{Project: "default", Name: "mapped", Node: "fixture", Architecture: 1, Description: "preserved native metadata", CreationDate: time.Unix(100, 0)}
+	if err = guardTx(db, func(tx *sql.Tx) error {
+		if err := guardBound(tx, "mapped"); err != nil {
+			return err
+		}
+		return guardReserveCreate(ctx, tx, "mapped", "fixture", 1, 999, "mapped")
+	}); err != nil {
+		t.Fatal(err)
+	}
+	// Inject post-mapper history failure. Caller intentionally commits after the
+	// error: internal savepoint must not leave an unbound inserted native row.
+	if _, err = db.Exec(`CREATE TRIGGER fail_guard_history BEFORE INSERT ON guard_row_history BEGIN SELECT RAISE(ABORT,'fixture history failure'); END`); err != nil {
+		t.Fatal(err)
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = guardCreateMappedRow(ctx, tx, "mapped", "fixture", object); err == nil {
+		t.Fatal("injected history failure ignored")
+	}
+	if err = tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var n int
+	if err = db.QueryRow(`SELECT count(*) FROM instances WHERE name='mapped'`).Scan(&n); err != nil || n != 0 {
+		t.Fatal("partial native row committed", n, err)
+	}
+	if _, err = db.Exec(`DROP TRIGGER fail_guard_history`); err != nil {
+		t.Fatal(err)
+	}
+	var token string
+	var id int64
+	if err = guardTx(db, func(tx *sql.Tx) error {
+		var err error
+		id, token, err = guardCreateMappedRow(ctx, tx, "mapped", "fixture", object)
+		return err
+	}); err != nil {
+		t.Fatal(err)
+	}
+	var description, current string
+	if err = db.QueryRow(`SELECT description,guard_token FROM instances WHERE id=?`, id).Scan(&description, &current); err != nil || description != object.Description || current != token {
+		t.Fatal(description, current, err)
+	}
+	if err = guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "mapped", "fixture", token) }); err != nil {
+		t.Fatal(err)
+	}
+	// Committed DB intent only: no native effect is invoked by this test.
+	for index, mutate := range []func(*Instance){func(o *Instance) { o.Type = 1 }, func(o *Instance) { o.Snapshot = true }, func(o *Instance) { o.Ephemeral = true }, func(o *Instance) { o.Stateful = true }} {
+		name := fmt.Sprintf("unsupported-%d", index)
+		candidate := object
+		candidate.Name = name
+		mutate(&candidate)
+		if err = guardTx(db, func(tx *sql.Tx) error {
+			if err := guardBound(tx, name); err != nil {
+				return err
+			}
+			return guardReserveCreate(ctx, tx, name, "fixture", 1, 999, name)
+		}); err != nil {
+			t.Fatal(err)
+		}
+		if err = guardTx(db, func(tx *sql.Tx) error {
+			_, _, err := guardCreateMappedRow(ctx, tx, name, "fixture", candidate)
+			return err
+		}); err == nil {
+			t.Fatal("unsupported native row admitted", index)
+		}
+		var n int
+		if err = db.QueryRow(`SELECT count(*) FROM instances WHERE name=?`, name).Scan(&n); err != nil || n != 0 {
+			t.Fatal("unsupported mapper row", n, err)
+		}
+		if err = db.QueryRow(`SELECT count(*) FROM guard_row_history WHERE request_id=?`, name).Scan(&n); err != nil || n != 0 {
+			t.Fatal("unsupported history", n, err)
+		}
+	}
+}
diff --git a/internal/server/db/cluster/guard_pending.go b/internal/server/db/cluster/guard_pending.go
new file mode 100644
index 000000000..c832d27b7
--- /dev/null
+++ b/internal/server/db/cluster/guard_pending.go
@@ -0,0 +1,117 @@
+package cluster
+
+// Offline candidate only: this migration is deliberately NOT registered in
+// updates and these primitives have no daemon callers or activation setting.
+// Authentication, native locks and effect dispatch are NOT implemented here.
+import (
+	"context"
+	"database/sql"
+	"errors"
+)
+
+var errGuardDenied = errors.New("native guard denied")
+
+func guardPendingMigration(ctx context.Context, tx *sql.Tx) error {
+	_, err := tx.ExecContext(ctx, `
+ ALTER TABLE instances ADD COLUMN guard_token TEXT;
+ CREATE UNIQUE INDEX instances_guard_token ON instances(guard_token) WHERE guard_token IS NOT NULL;
+ CREATE TRIGGER guard_token_immutable BEFORE UPDATE OF guard_token ON instances WHEN OLD.guard_token IS NOT NULL AND NEW.guard_token IS NOT OLD.guard_token BEGIN SELECT RAISE(ABORT,'immutable guard token'); END;
+ CREATE TABLE guard_row_history(request_id TEXT PRIMARY KEY, native_id INTEGER NOT NULL, token TEXT NOT NULL UNIQUE, project_id INTEGER NOT NULL, name TEXT NOT NULL);
+ CREATE TABLE guard_storage_attempts(request_id TEXT PRIMARY KEY, token TEXT NOT NULL, effect TEXT NOT NULL CHECK(effect='create_storage'), observed_return TEXT CHECK(observed_return IN ('success','error')));
+ CREATE TRIGGER guard_keep_rows BEFORE DELETE ON guard_row_history BEGIN SELECT RAISE(ABORT,'retained row history'); END;
+ CREATE TRIGGER guard_immutable_rows BEFORE UPDATE ON guard_row_history BEGIN SELECT RAISE(ABORT,'immutable row history'); END;
+ CREATE TRIGGER guard_keep_attempts BEFORE DELETE ON guard_storage_attempts BEGIN SELECT RAISE(ABORT,'retained attempt'); END;
+ CREATE TABLE guard_epoch (id INTEGER PRIMARY KEY CHECK(id=1), epoch INTEGER NOT NULL CHECK(epoch>0), sealed INTEGER NOT NULL CHECK(sealed IN (0,1)));
+ INSERT INTO guard_epoch VALUES(1,1,1);
+ CREATE TABLE guard_envelopes (
+ id TEXT PRIMARY KEY CHECK(length(id) BETWEEN 1 AND 128),
+ principal TEXT NOT NULL CHECK(length(principal) BETWEEN 1 AND 256),
+ epoch INTEGER NOT NULL,
+ state TEXT NOT NULL CHECK(state IN ('accepted','bound','abandoned')),
+ deadline INTEGER NOT NULL,
+ digest TEXT,
+ CHECK((state='bound' AND length(digest)=64) OR state!='bound')
+ );
+ CREATE TABLE guard_create_scopes (
+ request_id TEXT NOT NULL UNIQUE,
+ project_id INTEGER NOT NULL,
+ pool_id INTEGER NOT NULL,
+ name TEXT NOT NULL CHECK(length(name) BETWEEN 1 AND 63),
+ PRIMARY KEY(project_id,name),
+ UNIQUE(pool_id,project_id,name)
+ );
+ CREATE TRIGGER guard_keep_envelopes BEFORE DELETE ON guard_envelopes BEGIN SELECT RAISE(ABORT,'retained envelope'); END;
+ CREATE TRIGGER guard_keep_scopes BEFORE DELETE ON guard_create_scopes BEGIN SELECT RAISE(ABORT,'retained scope'); END;
+ CREATE TRIGGER guard_immutable_scope BEFORE UPDATE ON guard_create_scopes BEGIN SELECT RAISE(ABORT,'immutable scope'); END;
+ `)
+	return err
+}
+
+// Retained envelopes count against conservative fixed bounds even after
+// abandonment. No garbage collection/physical release is supplied.
+func guardAccept(ctx context.Context, tx *sql.Tx, epoch int64, id, principal string) error {
+	r, err := tx.ExecContext(ctx, `INSERT INTO guard_envelopes(id,principal,epoch,state,deadline)
+ SELECT ?,?,?,'accepted',CAST(strftime('%s','now') AS INTEGER)+30
+ WHERE EXISTS(SELECT 1 FROM guard_epoch WHERE id=1 AND epoch=? AND sealed=0)
+ AND (SELECT COUNT(*) FROM guard_envelopes)<64
+ AND (SELECT COUNT(*) FROM guard_envelopes WHERE principal=?)<8`, id, principal, epoch, epoch, principal)
+	return guardChanged(r, err)
+}
+func guardBindBody(ctx context.Context, tx *sql.Tx, id, principal, digest string, bytes int64) error {
+	if bytes < 0 || bytes > 1048576 || len(digest) != 64 {
+		return errGuardDenied
+	}
+	for _, c := range digest {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return errGuardDenied
+		}
+	}
+	r, err := tx.ExecContext(ctx, `UPDATE guard_envelopes SET state='bound',digest=? WHERE id=? AND principal=? AND state='accepted'
+ AND deadline>CAST(strftime('%s','now') AS INTEGER)
+ AND EXISTS(SELECT 1 FROM guard_epoch WHERE id=1 AND epoch=guard_envelopes.epoch AND sealed=0)`, digest, id, principal)
+	return guardChanged(r, err)
+}
+func guardAbandon(ctx context.Context, tx *sql.Tx, id, principal string) error {
+	// No bound/attempted request can be abandoned through this narrow primitive.
+	r, err := tx.ExecContext(ctx, `UPDATE guard_envelopes SET state='abandoned' WHERE id=? AND principal=? AND state='accepted'`, id, principal)
+	return guardChanged(r, err)
+}
+func guardReserveCreate(ctx context.Context, tx *sql.Tx, id, principal string, project, pool int64, name string) error {
+	// Deliberately restrictive canonical ASCII subset. Native alias/project feature
+	// handling and complete naming semantics remain an integration prerequisite.
+	if len(name) == 0 || len(name) > 63 {
+		return errGuardDenied
+	}
+	for i, c := range name {
+		if !(c >= 'a' && c <= 'z' || i > 0 && c >= '0' && c <= '9' || i > 0 && c == '-') {
+			return errGuardDenied
+		}
+	}
+	if name[len(name)-1] == '-' {
+		return errGuardDenied
+	}
+	r, err := tx.ExecContext(ctx, `INSERT INTO guard_create_scopes(request_id,project_id,pool_id,name)
+ SELECT ?,?,?,? WHERE EXISTS(SELECT 1 FROM guard_envelopes e JOIN guard_epoch g ON g.id=1 AND g.epoch=e.epoch WHERE e.id=? AND e.principal=? AND e.state='bound' AND g.sealed=0)
+ AND EXISTS(SELECT 1 FROM projects WHERE id=?)
+ AND EXISTS(SELECT 1 FROM storage_pools WHERE id=?)
+ AND NOT EXISTS(SELECT 1 FROM instances WHERE project_id=? AND name=?)
+ AND NOT EXISTS(SELECT 1 FROM storage_volumes WHERE project_id=? AND storage_pool_id=? AND name=?)`, id, project, pool, name, id, principal, project, pool, project, name, project, pool, name)
+	return guardChanged(r, err)
+}
+func guardSeal(ctx context.Context, tx *sql.Tx, epoch int64) error {
+	r, err := tx.ExecContext(ctx, `UPDATE guard_epoch SET sealed=1 WHERE id=1 AND epoch=? AND sealed=0`, epoch)
+	return guardChanged(r, err)
+}
+func guardChanged(r sql.Result, err error) error {
+	if err != nil {
+		return err
+	}
+	n, err := r.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return errGuardDenied
+	}
+	return nil
+}
diff --git a/internal/server/db/cluster/guard_pending_test.go b/internal/server/db/cluster/guard_pending_test.go
new file mode 100644
index 000000000..6ac331c2a
--- /dev/null
+++ b/internal/server/db/cluster/guard_pending_test.go
@@ -0,0 +1,220 @@
+package cluster
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func guardFixture(t *testing.T) *sql.DB {
+	t.Helper()
+	s := Schema()
+	s.Add(guardPendingMigration)
+	db, err := s.ExerciseUpdate(SchemaVersion+1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	_, err = db.Exec(`INSERT INTO storage_pools(id,name,driver,description) VALUES(999,'guard-fixture','dir','');`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return db
+}
+func guardTx(db *sql.DB, f func(*sql.Tx) error) error {
+	tx, err := db.Begin()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if err = f(tx); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+func guardEnableFixture(t *testing.T, db *sql.DB) {
+	t.Helper()
+	if _, err := db.Exec(`UPDATE guard_epoch SET sealed=0`); err != nil {
+		t.Fatal(err)
+	}
+}
+func guardBound(tx *sql.Tx, id string) error {
+	ctx := context.Background()
+	if err := guardAccept(ctx, tx, 1, id, "fixture"); err != nil {
+		return err
+	}
+	return guardBindBody(ctx, tx, id, "fixture", strings.Repeat("a", 64), 16)
+}
+func TestGuardPendingMigrationIsNotRegistered(t *testing.T) {
+	db, err := Schema().ExerciseUpdate(SchemaVersion, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	var count int
+	if err = db.QueryRow(`SELECT count(*) FROM sqlite_master WHERE name='guard_epoch'`).Scan(&count); err != nil || count != 0 {
+		t.Fatal("candidate became active", count, err)
+	}
+	db2 := guardFixture(t)
+	if err = guardTx(db2, func(tx *sql.Tx) error { return guardAccept(context.Background(), tx, 1, "first", "fixture") }); err == nil {
+		t.Fatal("migration must start sealed")
+	}
+}
+func TestGuardAbandonedBodyNeverBindsOrReserves(t *testing.T) {
+	db := guardFixture(t)
+	guardEnableFixture(t, db)
+	ctx := context.Background()
+	if err := guardTx(db, func(tx *sql.Tx) error {
+		if err := guardAccept(ctx, tx, 1, "a", "fixture"); err != nil {
+			return err
+		}
+		return guardAbandon(ctx, tx, "a", "fixture")
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardBindBody(ctx, tx, "a", "fixture", strings.Repeat("a", 64), 1) }); err == nil {
+		t.Fatal("abandoned body bound")
+	}
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardReserveCreate(ctx, tx, "a", "fixture", 1, 999, "one") }); err == nil {
+		t.Fatal("abandoned body reserved")
+	}
+	for i := 0; i < 7; i++ {
+		if err := guardTx(db, func(tx *sql.Tx) error { return guardAccept(ctx, tx, 1, fmt.Sprint(i), "fixture") }); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardAccept(ctx, tx, 1, "overflow", "fixture") }); err == nil {
+		t.Fatal("retained envelope quota bypass")
+	}
+	if _, err := db.Exec(`DELETE FROM guard_envelopes`); err == nil {
+		t.Fatal("history deleted")
+	}
+}
+func TestGuardScopeSurvivesNativeRowCleanup(t *testing.T) {
+	db := guardFixture(t)
+	guardEnableFixture(t, db)
+	ctx := context.Background()
+	if err := guardTx(db, func(tx *sql.Tx) error {
+		if err := guardBound(tx, "a"); err != nil {
+			return err
+		}
+		return guardReserveCreate(ctx, tx, "a", "fixture", 1, 999, "one")
+	}); err != nil {
+		t.Fatal(err)
+	}
+	// Actual pinned native schema/row, not a replacement minimal instances table.
+	_, err := db.Exec(`INSERT INTO nodes(id,name,description,address,schema,api_extensions,arch) VALUES(999,'fixture','','fixture',73,1,1);
+ INSERT INTO instances(node_id,name,architecture,type,description,project_id) VALUES(999,'one',1,0,'',1);
+ DELETE FROM instances WHERE name='one';`)
+	if err != nil {
