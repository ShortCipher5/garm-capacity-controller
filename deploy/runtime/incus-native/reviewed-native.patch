@@ -0,0 +1,326 @@
+package nativefrontier
+
+// Offline per-native-call journal seam. SQLite and fake storage are not Incus
+// cowsql/driver execution. Native locks, sole writers and complete coverage are
+// absent: this records uncertainty; it NEVER authorizes release or repetition.
+import (
+	"database/sql"
+	"errors"
+	"go/format"
+	"os"
+	"strings"
+	"testing"
+)
+
+const attemptSchema = `CREATE TABLE mutation_parents(request TEXT PRIMARY KEY REFERENCES accepted(request), incarnation TEXT NOT NULL REFERENCES incarnations(token));
+CREATE TABLE mutation_attempts(
+ request TEXT NOT NULL REFERENCES mutation_parents(request), phase TEXT NOT NULL CHECK(phase IN ('delete','create')),
+ incarnation TEXT NOT NULL, observation TEXT NOT NULL CHECK(observation IN ('attempted','returned_success','returned_error')),
+ PRIMARY KEY(request,phase));
+ CREATE TRIGGER keep_attempt BEFORE DELETE ON mutation_attempts BEGIN SELECT RAISE(ABORT,'retain attempt'); END;`
+
+func beginStorageAttempt(d *sql.DB, request, phase, incarnation string) error {
+	// No callback on failed/unknown COMMIT. A duplicate phase is NOT retried,
+	// including when its previous call returned an error after a native effect.
+	return transaction(d, func(tx *sql.Tx) error {
+		r, err := tx.Exec(`INSERT INTO mutation_attempts SELECT ?,?,?,'attempted' FROM accepted a JOIN epoch e ON e.id=1 AND e.generation=a.epoch JOIN mutation_parents p ON p.request=a.request AND p.incarnation=? WHERE a.request=? AND a.state='accepted' AND e.sealed=0 AND EXISTS(SELECT 1 FROM instances i JOIN incarnations n ON n.instance_id=i.id AND n.token=i.native_token WHERE n.token=?) AND (?='delete' OR EXISTS(SELECT 1 FROM mutation_attempts m WHERE m.request=a.request AND m.phase='delete' AND m.observation='returned_success'))`, request, phase, incarnation, incarnation, request, incarnation, phase)
+		if err != nil {
+			return err
+		}
+		n, err := r.RowsAffected()
+		if err != nil {
+			return err
+		}
+		if n != 1 {
+			return denied
+		}
+		return nil
+	})
+}
+
+func storageAttempt(d *sql.DB, request, phase, incarnation string, native func() error) error {
+	err := beginStorageAttempt(d, request, phase, incarnation)
+	if err != nil {
+		return err
+	}
+
+	nativeErr := native()
+	observation := "returned_success"
+	if nativeErr != nil {
+		observation = "returned_error"
+	}
+	r, err := d.Exec(`UPDATE mutation_attempts SET observation=? WHERE request=? AND phase=? AND observation='attempted'`, observation, request, phase)
+	if err != nil {
+		return errors.Join(nativeErr, err)
+	}
+	if n, countErr := r.RowsAffected(); countErr != nil || n != 1 {
+		return errors.Join(nativeErr, denied, countErr)
+	}
+	return nativeErr
+}
+
+type rebuildImage struct{ Fingerprint string }
+type rebuildStorage struct {
+	d                            *sql.DB
+	token                        string
+	physical                     bool
+	loseDeleteACK, loseCreateACK bool
+	calls                        []string
+}
+
+func (p *rebuildStorage) DeleteInstance(_ any, _ any) error {
+	return storageAttempt(p.d, "rebuild", "delete", p.token, func() error {
+		p.calls = append(p.calls, "delete")
+		p.physical = false
+		if p.loseDeleteACK {
+			return errors.New("delete ACK unknown")
+		}
+		return nil
+	})
+}
+func (p *rebuildStorage) CreateInstance(_ any, _ any) error { return p.create("empty") }
+func (p *rebuildStorage) CreateInstanceFromImage(_ any, _ string, _ any) error {
+	return p.create("image")
+}
+func (p *rebuildStorage) create(kind string) error {
+	return storageAttempt(p.d, "rebuild", "create", p.token, func() error {
+		p.calls = append(p.calls, kind)
+		p.physical = true
+		if p.loseCreateACK {
+			return errors.New("create ACK unknown")
+		}
+		return nil
+	})
+}
+
+// Exact storage-only prefix of pinned rebuildCommon; config updates and driver
+// preparation are deliberately NOT executed. Signature/predeclared err and the
+// final return are fixture scaffolding, checked against the source slice below.
+func pinnedRebuildStorage(pool *rebuildStorage, inst any, img *rebuildImage, op any) error {
+	var err error
+	err = pool.DeleteInstance(inst, op)
+	if err != nil {
+		return err
+	}
+
+	// Rebuild as empty if there is no image provided.
+	if img == nil {
+		err = pool.CreateInstance(inst, nil)
+		if err != nil {
+			return err
+		}
+	} else {
+		err = pool.CreateInstanceFromImage(inst, img.Fingerprint, op)
+		if err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+func TestPinnedRebuildStoragePrefixIdentity(t *testing.T) {
+	pinnedMethod(t, "internal/server/instance/drivers/driver_common.go", "4285ff9e2c791a85a6420da5abed139b5ec61edfa47f1033e3905e566d90a60f", "rebuildCommon")
+	raw, err := os.ReadFile("../../internal/server/instance/drivers/driver_common.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	src := string(raw)
+	start := strings.Index(src, "func (d *common) rebuildCommon(")
+	src = src[start:]
+	start = strings.Index(src, "err = pool.DeleteInstance(inst, op)")
+	end := strings.Index(src, "err = d.state.DB.Cluster.Transaction")
+	expected, err := format.Source([]byte("package nativefrontier\nfunc pinnedRebuildStorage(pool *rebuildStorage, inst any, img *rebuildImage, op any) error { var err error\n" + src[start:end] + "return nil\n}"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, err := os.ReadFile("storage_attempt_test.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(own)
+	start = strings.Index(text, "func pinnedRebuildStorage(")
+	end = strings.Index(text, "func TestPinnedRebuildStoragePrefixIdentity(")
+	actual, err := format.Source([]byte("package nativefrontier\n" + text[start:end]))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(actual) != string(expected) {
+		t.Fatal("pinned storage prefix changed")
+	}
+}
+func storageFixture(t *testing.T) *sql.DB {
+	d := database(t)
+	if _, err := d.Exec(attemptSchema); err != nil {
+		t.Fatal(err)
+	}
+	if err := transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "birth") }); err != nil {
+		t.Fatal(err)
+	}
+	if err := rowBirth(d, "birth", "native-incarnation", "guest"); err != nil {
+		t.Fatal(err)
+	}
+	if err := transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "rebuild") }); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := d.Exec("INSERT INTO mutation_parents VALUES('rebuild','native-incarnation')"); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+func retainedAttempts(t *testing.T, d *sql.DB) int {
+	t.Helper()
+	var n int
+	if err := d.QueryRow("SELECT count(*) FROM mutation_attempts").Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+func TestRebuildUnknownDeleteStopsBirthAndCannotReplay(t *testing.T) {
+	d := storageFixture(t)
+	p := &rebuildStorage{d: d, token: "native-incarnation", physical: true, loseDeleteACK: true}
+	if err := pinnedRebuildStorage(p, nil, nil, nil); err == nil {
+		t.Fatal("lost ACK accepted")
+	}
+	if len(p.calls) != 1 || p.physical || retainedAttempts(t, d) != 1 {
+		t.Fatal("delete uncertainty lost")
+	}
+	if err := pinnedRebuildStorage(p, nil, nil, nil); err == nil || len(p.calls) != 1 {
+		t.Fatal("unknown attempt replayed")
+	}
+}
+func TestRebuildNativeCreateErrorRetainsAttemptHistory(t *testing.T) {
+	for _, img := range []*rebuildImage{nil, {Fingerprint: "fixture-image"}} {
+		t.Run(func() string {
+			if img == nil {
+				return "empty"
+			}
+			return "image"
+		}(), func(t *testing.T) {
+			d := storageFixture(t)
+			p := &rebuildStorage{d: d, token: "native-incarnation", physical: true, loseCreateACK: true}
+			if err := pinnedRebuildStorage(p, nil, img, nil); err == nil {
+				t.Fatal("unknown create accepted")
+			}
+			if !p.physical || len(p.calls) != 2 || retainedAttempts(t, d) != 2 {
+				t.Fatal("lost rebuild effects/history")
+			}
+			if _, err := d.Exec("DELETE FROM mutation_attempts"); err == nil {
+				t.Fatal("attempts could be discarded")
+			}
+		})
+	}
+}
+func TestSealAfterAttemptDoesNotProveNativeQuiescence(t *testing.T) {
+	d := storageFixture(t)
+	effectObserved := false
+	err := storageAttempt(d, "rebuild", "delete", "native-incarnation", func() error {
+		if err := transaction(d, func(tx *sql.Tx) error { return seal(tx, 1) }); err != nil {
+			return err
+		}
+		effectObserved = true // accepted callback executes AFTER seal; still retained.
+		return nil
+	})
+	if err != nil || !effectObserved || retainedAttempts(t, d) != 1 {
+		t.Fatal("late accepted effect/history counterexample lost", err)
+	}
+	if err := storageAttempt(d, "rebuild", "create", "native-incarnation", func() error { t.Fatal("sealed new attempt dispatched"); return nil }); err == nil {
+		t.Fatal("seal admitted new attempt")
+	}
+}
+func TestOutcomeJournalFailureRetainsAttemptAcrossReopen(t *testing.T) {
+	d := storageFixture(t)
+	var seq int
+	var name, file string
+	if err := d.QueryRow("PRAGMA database_list").Scan(&seq, &name, &file); err != nil {
+		t.Fatal(err)
+	}
+	physical := false
+	err := storageAttempt(d, "rebuild", "delete", "native-incarnation", func() error { physical = true; return d.Close() })
+	if err == nil || !physical {
+		t.Fatal("lost outcome journal not surfaced")
+	}
+	reopened, err := sql.Open("sqlite3", file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.Close()
+	var observation string
+	if err := reopened.QueryRow("SELECT observation FROM mutation_attempts").Scan(&observation); err != nil {
+		t.Fatal(err)
+	}
+	if observation != "attempted" {
+		t.Fatal("unknown outcome fabricated", observation)
+	}
+}
+func TestMissingCurrentIncarnationDeniesBeforeNativeCall(t *testing.T) {
+	d := storageFixture(t)
+	if _, err := d.Exec("DELETE FROM instances"); err != nil {
+		t.Fatal(err)
+	}
+	if err := storageAttempt(d, "rebuild", "delete", "native-incarnation", func() error { t.Fatal("missing incarnation dispatched"); return nil }); err == nil {
+		t.Fatal("missing identity accepted")
+	}
+	if retainedAttempts(t, d) != 0 {
+		t.Fatal("denied attempt persisted")
+	}
+}
+
+func TestCrashAfterAttemptBeforeNativeCallNeverAutoReissues(t *testing.T) {
+	d := storageFixture(t)
+	if err := beginStorageAttempt(d, "rebuild", "delete", "native-incarnation"); err != nil {
+		t.Fatal(err)
+	}
+	// Simulate process death at this durable boundary by discarding execution;
+	// no physical callback happened. The unresolved attempt still forbids replay.
+	if err := storageAttempt(d, "rebuild", "delete", "native-incarnation", func() error { t.Fatal("unknown attempt replayed"); return nil }); err == nil {
+		t.Fatal("duplicate accepted")
+	}
+	if retainedAttempts(t, d) != 1 {
+		t.Fatal("uncertainty erased")
+	}
+}
+func TestCrashBetweenRebuildPhasesKeepsParentAndDoesNotReplayPrefix(t *testing.T) {
+	d := storageFixture(t)
+	p := &rebuildStorage{d: d, token: "native-incarnation", physical: true}
+	if err := p.DeleteInstance(nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	// No automatic resumption protocol is implemented. Re-entering the outer
+	// prefix must not delete again or assume absence gives a fresh allocation.
+	if err := pinnedRebuildStorage(p, nil, nil, nil); err == nil {
+		t.Fatal("prefix replayed")
+	}
+	var parents int
+	if err := d.QueryRow("SELECT count(*) FROM mutation_parents").Scan(&parents); err != nil {
+		t.Fatal(err)
+	}
+	if parents != 1 || retainedAttempts(t, d) != 1 || len(p.calls) != 1 || p.physical {
+		t.Fatal("parent or attempted history lost")
+	}
+}
+func TestStorageAttemptRequiresBoundTargetAndPriorPhase(t *testing.T) {
+	d := storageFixture(t)
+	for _, c := range []struct{ phase, token string }{{"delete", "different-incarnation"}, {"create", "native-incarnation"}, {"restore", "native-incarnation"}} {
+		if err := storageAttempt(d, "rebuild", c.phase, c.token, func() error { t.Fatal("unbound or out-of-order native call"); return nil }); err == nil {
+			t.Fatal("invalid attempt admitted", c)
+		}
+	}
+	if retainedAttempts(t, d) != 0 {
+		t.Fatal("invalid intent recorded")
+	}
+}
+
+func TestRebuildSuccessfulReturnsStillRetainAllAttemptHistory(t *testing.T) {
+	d := storageFixture(t)
+	p := &rebuildStorage{d: d, token: "native-incarnation", physical: true}
+	if err := pinnedRebuildStorage(p, nil, nil, nil); err != nil {
