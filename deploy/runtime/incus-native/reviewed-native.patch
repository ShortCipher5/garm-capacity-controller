+// Offline SQL transaction experiment only; not linked by incusd.
+package nativefrontier
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+var denied = errors.New("native frontier denied")
+
+const schema = `
+CREATE TABLE epoch(id INTEGER PRIMARY KEY CHECK(id=1), generation INTEGER NOT NULL, sealed INTEGER NOT NULL);
+INSERT INTO epoch VALUES(1,1,0);
+CREATE TABLE accepted(seq INTEGER PRIMARY KEY AUTOINCREMENT, request TEXT NOT NULL UNIQUE, epoch INTEGER NOT NULL, state TEXT NOT NULL CHECK(state IN ('accepted','row_bound','deleting')));
+-- Minimal native row fixture, NOT Incus's full schema or all driver side effects.
+CREATE TABLE instances(id INTEGER PRIMARY KEY, project TEXT NOT NULL, name TEXT NOT NULL, native_token TEXT, UNIQUE(project,name));
+CREATE TABLE incarnations(token TEXT PRIMARY KEY, instance_id INTEGER NOT NULL UNIQUE, request TEXT NOT NULL UNIQUE REFERENCES accepted(request), state TEXT NOT NULL CHECK(state IN ('row_bound','deleting')));
+CREATE TRIGGER keep_request BEFORE DELETE ON accepted BEGIN SELECT RAISE(ABORT,'retain history'); END;
+`
+
+func database(t *testing.T) *sql.DB {
+	t.Helper()
+	d, err := sql.Open("sqlite3", "file:"+filepath.Join(t.TempDir(), "native.db")+"?_journal_mode=WAL&_synchronous=FULL&_foreign_keys=on&_txlock=immediate&_busy_timeout=5000")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { d.Close() })
+	if _, err = d.Exec(schema); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+func transaction(d *sql.DB, f func(*sql.Tx) error) error {
+	tx, err := d.Begin()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if err = f(tx); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+func accept(tx *sql.Tx, epoch int, id string) error {
+	r, err := tx.Exec(`INSERT INTO accepted(request,epoch,state) SELECT ?,generation,'accepted' FROM epoch WHERE id=1 AND generation=? AND sealed=0`, id, epoch)
+	if err != nil {
+		return err
+	}
+	n, err := r.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return denied
+	}
+	return nil
+}
+func seal(tx *sql.Tx, epoch int) error {
+	r, err := tx.Exec(`UPDATE epoch SET sealed=1 WHERE id=1 AND generation=? AND sealed=0`, epoch)
+	if err != nil {
+		return err
+	}
+	n, err := r.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return denied
+	}
+	return nil
+}
+
+// claimRow records only database-row authorization, never physical birth/outcome.
+// claimRow must run in the very SAME transaction as the native INSERT.
+// Tokens here are deterministic test values; production must generate an
+// unforgeable/non-reused incarnation itself, never take caller volatile.uuid.
+func claimRow(tx *sql.Tx, epoch int, id, token string, nativeID int64) error {
+	r, err := tx.Exec(`UPDATE accepted SET state='row_bound' WHERE request=? AND epoch=? AND state='accepted' AND EXISTS(SELECT 1 FROM epoch WHERE id=1 AND generation=? AND sealed=0) AND EXISTS(SELECT 1 FROM instances WHERE id=? AND native_token=?)`, id, epoch, epoch, nativeID, token)
+	if err != nil {
+		return err
+	}
+	n, err := r.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return denied
+	}
+	_, err = tx.Exec(`INSERT INTO incarnations VALUES(?,?,?,'row_bound')`, token, nativeID, id)
+	return err
+}
+func rowBirth(d *sql.DB, id, token, name string) error {
+	return transaction(d, func(tx *sql.Tx) error {
+		r, err := tx.Exec(`INSERT INTO instances(project,name,native_token) VALUES('default',?,?)`, name, token)
+		if err != nil {
+			return err
+		}
+		row, err := r.LastInsertId()
+		if err != nil {
+			return err
+		}
+		return claimRow(tx, 1, id, token, row)
+	})
+}
+
+// beginDelete is merely an identity guard + durable intent, NOT permission to
+// call a driver. A real adapter must hold native lifecycle locks/reservations
+// across physical cleanup and every rename/start/restore path. No finalizer exists.
+func beginDelete(tx *sql.Tx, token string, row int64) error {
+	r, err := tx.Exec(`UPDATE incarnations SET state='deleting' WHERE token=? AND instance_id=? AND state='row_bound' AND EXISTS(SELECT 1 FROM instances WHERE id=incarnations.instance_id AND native_token=incarnations.token)`, token, row)
+	if err != nil {
+		return err
+	}
+	n, err := r.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return denied
+	}
+	_, err = tx.Exec(`UPDATE accepted SET state='deleting' WHERE request=(SELECT request FROM incarnations WHERE token=?)`, token)
+	return err
+}
+func count(t *testing.T, d *sql.DB, table string) int {
+	t.Helper()
+	var n int
+	if err := d.QueryRow("SELECT COUNT(*) FROM " + table).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+func must(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestLateAcceptedHandlerCannotCommitBirthAfterSeal(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "pre-body") }))
+	must(t, transaction(d, func(tx *sql.Tx) error { return seal(tx, 1) }))
+	if !errors.Is(rowBirth(d, "pre-body", "inc1", "runner"), denied) {
+		t.Fatal("late birth accepted")
+	}
+	if count(t, d, "instances") != 0 || count(t, d, "incarnations") != 0 || count(t, d, "accepted") != 1 {
+		t.Fatal("rollback/history violated")
+	}
+}
+func TestBirthCommittedBeforeSealRemainsChargedAndNoRepeat(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+	must(t, rowBirth(d, "r", "inc1", "runner"))
+	must(t, transaction(d, func(tx *sql.Tx) error { return seal(tx, 1) }))
+	if rowBirth(d, "r", "inc2", "other") == nil {
+		t.Fatal("repeat")
+	}
+	if count(t, d, "instances") != 1 || count(t, d, "incarnations") != 1 {
+		t.Fatal("lost birth")
+	}
+}
+func TestTransactionRollbackDoesNotConsumeGrant(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+	injected := errors.New("after native insertion before commit")
+	err := transaction(d, func(tx *sql.Tx) error {
+		_, e := tx.Exec(`INSERT INTO instances VALUES(1,'default','runner','inc1')`)
+		if e != nil {
+			return e
+		}
+		if e = claimRow(tx, 1, "r", "inc1", 1); e != nil {
+			return e
+		}
+		return injected
+	})
+	if !errors.Is(err, injected) || count(t, d, "instances") != 0 {
+		t.Fatal(err)
+	}
+	must(t, rowBirth(d, "r", "inc1", "runner"))
+}
+func TestLostCommitAcknowledgmentCannotDuplicateBirth(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+	// COMMIT succeeds but caller intentionally discards its success. This is not
+	// a simulated OS fsync failure: recovery is conservative for an unknown ACK.
+	must(t, rowBirth(d, "r", "inc1", "runner"))
+	if rowBirth(d, "r", "inc2", "replacement") == nil {
+		t.Fatal("duplicate")
+	}
+	if count(t, d, "instances") != 1 {
+		t.Fatal("repeat side effect")
+	}
+}
+func TestSealBirthSerialization(t *testing.T) {
+	for i := 0; i < 20; i++ {
+		d := database(t)
+		must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+		var wg sync.WaitGroup
+		wg.Add(2)
+		var b, s error
+		go func() { defer wg.Done(); b = rowBirth(d, "r", "inc1", "runner") }()
+		go func() { defer wg.Done(); s = transaction(d, func(tx *sql.Tx) error { return seal(tx, 1) }) }()
+		wg.Wait()
+		must(t, s)
+		if b != nil && !errors.Is(b, denied) {
+			t.Fatal(b)
+		}
+		n := count(t, d, "instances")
+		if (b == nil && n != 1) || (b != nil && n != 0) {
+			t.Fatal("partial birth")
+		}
+	}
+}
+func TestImmutableIdentityCheckedBeforeAnyCleanup(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+	must(t, rowBirth(d, "r", "new-incarnation", "runner"))
+	cleanup := 0
+	err := transaction(d, func(tx *sql.Tx) error { return beginDelete(tx, "stale-incarnation", 1) })
+	if err == nil {
+		cleanup++
+	}
+	if !errors.Is(err, denied) || cleanup != 0 {
+		t.Fatal("stale delete")
+	}
+	must(t, transaction(d, func(tx *sql.Tx) error { return beginDelete(tx, "new-incarnation", 1) }))
+	if count(t, d, "instances") != 1 || count(t, d, "accepted") != 1 {
+		t.Fatal("intent incorrectly reclaimed")
+	}
+}
+func TestUncoveredNativeWritesRemainCounterexample(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return seal(tx, 1) }))
+	_, err := d.Exec(`INSERT INTO instances VALUES(1,'foreign','bypass',NULL)`)
+	must(t, err)
+	if count(t, d, "instances") != 1 || count(t, d, "incarnations") != 0 {
+		t.Fatal("counterexample lost")
+	}
+	t.Log(fmt.Sprint("extension not wired: direct native mapper bypass remains possible; no authority"))
+}
+
+// Incus CreateInternal commits its row before storage CreateInstance and backup.
+// A later revert may remove the row while physical cleanup remains unknown.
+func TestPostCommitRowRevertDoesNotEraseUnknownPhysicalHistory(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+	must(t, rowBirth(d, "r", "inc1", "runner"))
+	_, err := d.Exec(`DELETE FROM instances WHERE id=1`)
+	must(t, err)
+	if count(t, d, "instances") != 0 || count(t, d, "incarnations") != 1 || count(t, d, "accepted") != 1 {
+		t.Fatal("native row revert erased history")
+	}
+	must(t, transaction(d, func(tx *sql.Tx) error { return seal(tx, 1) }))
+	if rowBirth(d, "r", "inc2", "runner") == nil {
+		t.Fatal("reused unresolved intent")
+	}
+}
+
+func TestDeletedAndReusedRowIDsDoNotAuthorizeOldDelete(t *testing.T) {
+	d := database(t)
+	must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+	must(t, rowBirth(d, "r", "old", "runner"))
+	_, err := d.Exec(`DELETE FROM instances WHERE id=1`)
+	must(t, err)
+	if !errors.Is(transaction(d, func(tx *sql.Tx) error { return beginDelete(tx, "old", 1) }), denied) {
+		t.Fatal("absent row allowed old delete")
+	}
+	_, err = d.Exec(`INSERT INTO instances VALUES(1,'default','runner','replacement')`)
+	must(t, err)
+	if !errors.Is(transaction(d, func(tx *sql.Tx) error { return beginDelete(tx, "old", 1) }), denied) {
+		t.Fatal("reused row ID allowed old delete")
+	}
+}
+
+func TestClaimRowChecksCurrentNativeIdentity(t *testing.T) {
+	for _, present := range []bool{false, true} {
+		d := database(t)
+		must(t, transaction(d, func(tx *sql.Tx) error { return accept(tx, 1, "r") }))
+		if present {
+			_, err := d.Exec(`INSERT INTO instances VALUES(1,'default','runner','actual')`)
+			must(t, err)
+		}
+		err := transaction(d, func(tx *sql.Tx) error { return claimRow(tx, 1, "r", "wrong", 1) })
+		if !errors.Is(err, denied) || count(t, d, "incarnations") != 0 {
+			t.Fatal("invalid row claim", err)
+		}
+		var state string
+		must(t, d.QueryRow(`SELECT state FROM accepted WHERE request='r'`).Scan(&state))
+		if state != "accepted" {
+			t.Fatal("consumed invalid grant")
+		}
+	}
+}
diff --git a/qualification/nativefrontier/lifecycle_tail_test.go b/qualification/nativefrontier/lifecycle_tail_test.go
new file mode 100644
index 000000000..00793e653
--- /dev/null
+++ b/qualification/nativefrontier/lifecycle_tail_test.go
@@ -0,0 +1,148 @@
+package nativefrontier
+
+// Exact pinned callback TAIL only. Scheduling, driver I/O and operation records
+// are simulations. The earlier stop/cleanup/autorestart decision is not executed.
+import (
+	"errors"
+	"fmt"
+	"go/format"
+	"os"
+	"strings"
+	"testing"
+)
+
+type lifecycleFixture struct {
+	ephemeral, effectObserved, fail            bool
+	starts, deletes, notifications, rebalances int
+}
+
+func (d *lifecycleFixture) Start(_ bool) error {
+	d.starts++
+	d.effectObserved = true
+	if d.fail {
+		return errors.New("unknown restart outcome")
+	}
+	return nil
+}
+func (d *lifecycleFixture) delete(_ bool) error {
+	d.deletes++
+	d.effectObserved = true
+	if d.fail {
+		return errors.New("unknown deletion outcome")
+	}
+	return nil
+}
+func (d *lifecycleFixture) notifyRestart() { d.notifications++ }
+func (d *lifecycleFixture) rebalance()     { d.rebalances++ }
+
+type lifecycleOperation struct{ errors []error }
+
+func (o *lifecycleOperation) Done(err error) { o.errors = append(o.errors, err) }
+func pinnedStopCallbackTail(d *lifecycleFixture, target string, autoRestart bool, op *lifecycleOperation) {
+	var err error // Declared in enclosing upstream callback.
+	// Reboot the container
+	if target == "reboot" || autoRestart {
+		// Start the container again
+		err = d.Start(false)
+		if err != nil {
+			op.Done(fmt.Errorf("Failed restarting instance: %w", err))
+			return
+		}
+
+		d.notifyRestart()
+
+		return
+	}
+
+	// Trigger a rebalance
+	d.rebalance()
+
+	// Destroy ephemeral containers
+	if d.ephemeral {
+		err = d.delete(true)
+		if err != nil {
+			op.Done(fmt.Errorf("Failed deleting ephemeral instance: %w", err))
+			return
+		}
+	}
+}
+
+func TestPinnedStopTailIdentity(t *testing.T) {
+	pinnedMethod(t, "internal/server/instance/drivers/driver_lxc.go", "5d2502f80e72098decb5f57f2df644006e0a17c0f8a93f017a216a6dcf59fda8", "onStop")
+	raw, err := os.ReadFile("../../internal/server/instance/drivers/driver_lxc.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	src := string(raw)
+	src = src[strings.Index(src, "func (d *lxc) onStop("):]
+	src = src[strings.Index(src, "// Reboot the container"):strings.Index(src, "}(d, target, op)")]
+	src = strings.ReplaceAll(src, "d.state.Events.SendLifecycle(d.project.Name, lifecycle.InstanceRestarted.Event(d, nil))", "d.notifyRestart()")
+	src = strings.ReplaceAll(src, `cgroup.TaskSchedulerTrigger("container", d.name, "stopped")`, "d.rebalance()")
+	signature := "func pinnedStopCallbackTail(d *lifecycleFixture,target string,autoRestart bool,op *lifecycleOperation){\nvar err error // Declared in enclosing upstream callback.\n"
+	expected, err := format.Source([]byte("package nativefrontier\n" + signature + src + "}"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, err := os.ReadFile("lifecycle_tail_test.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(own)
+	text = text[strings.Index(text, "func pinnedStopCallbackTail("):strings.Index(text, "func TestPinnedStopTailIdentity(")]
+	actual, err := format.Source([]byte("package nativefrontier\n" + text))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(expected) != string(actual) {
+		t.Fatal("pinned tail changed")
+	}
+}
+func TestRestartTailSkipsEphemeralDelete(t *testing.T) {
+	for _, tc := range []struct {
+		target string
+		auto   bool
+	}{{"reboot", false}, {"stop", true}} {
+		d := &lifecycleFixture{ephemeral: true}
+		op := &lifecycleOperation{}
+		pinnedStopCallbackTail(d, tc.target, tc.auto, op)
+		if d.starts != 1 || d.deletes != 0 || d.notifications != 1 || d.rebalances != 0 {
+			t.Fatal("restart branch changed", d)
+		}
+	}
+}
+func TestInternalTailErrorsDoNotProveNoEffect(t *testing.T) {
+	for _, target := range []string{"stop", "reboot"} {
+		d := &lifecycleFixture{ephemeral: true, fail: true}
+		op := &lifecycleOperation{}
+		pinnedStopCallbackTail(d, target, false, op)
+		if !d.effectObserved || len(op.errors) != 1 || op.errors[0] == nil {
+			t.Fatal("unknown native outcome erased", d, op)
+		}
+		if target == "stop" && (d.deletes != 1 || d.starts != 0) {
+			t.Fatal("internal deletion not called")
+		}
+	}
+}
+func TestQueuedInternalCallbackAfterAPIReturnAndSeal(t *testing.T) {
+	d := &lifecycleFixture{ephemeral: true}
+	op := &lifecycleOperation{}
+	// A test-owned queue models upstream goroutine scheduling, not the daemon.
+	callback := func() { pinnedStopCallbackTail(d, "stop", false, op) }
+	apiReturned := true
+	ingressSealed := true
+	if !apiReturned || !ingressSealed || d.effectObserved {
+		t.Fatal("fixture ordering")
+	}
+	callback()
+	if d.deletes != 1 || !d.effectObserved {
+		t.Fatal("API-only seal was incorrectly treated as native callback fence")
+	}
+	// No authority, capacity charge, release, or real operation completion is inferred.
+}
+func TestNonEphemeralStopTailDoesNotDelete(t *testing.T) {
+	d := &lifecycleFixture{}
+	pinnedStopCallbackTail(d, "stop", false, &lifecycleOperation{})
+	if d.starts != 0 || d.deletes != 0 || d.rebalances != 1 {
+		t.Fatal("non-ephemeral branch changed", d)
+	}
+}
diff --git a/qualification/nativefrontier/mutation_boundaries_test.go b/qualification/nativefrontier/mutation_boundaries_test.go
new file mode 100644
index 000000000..9d2c3ad82
--- /dev/null
+++ b/qualification/nativefrontier/mutation_boundaries_test.go
@@ -0,0 +1,144 @@
+package nativefrontier
+
+// Source-contract fixtures only: these parse pinned upstream code. They do not
+// execute an Incus driver, discover every caller, or provide release authority.
+import (
+	"crypto/sha256"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"testing"
+)
+
+func pinnedMethod(t *testing.T, path, hash, name string) *ast.FuncDecl {
+	t.Helper()
+	raw, err := os.ReadFile("../../" + path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fmt.Sprintf("%x", sha256.Sum256(raw)) != hash {
+		t.Fatal("pinned source changed:", path)
+	}
+	file, err := parser.ParseFile(token.NewFileSet(), path, raw, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var found *ast.FuncDecl
+	for _, decl := range file.Decls {
+		if fn, ok := decl.(*ast.FuncDecl); ok && fn.Name.Name == name {
+			if found != nil {
+				t.Fatal("ambiguous method", name)
+			}
+			found = fn
+		}
+	}
+	if found == nil {
+		t.Fatal("method missing", name)
+	}
+	return found
+}
+func selectorName(expr ast.Expr) string {
+	switch x := expr.(type) {
+	case *ast.Ident:
+		return x.Name
+	case *ast.SelectorExpr:
+		return selectorName(x.X) + "." + x.Sel.Name
+	}
+	return ""
+}
+func callsNamed(node ast.Node, name string) []*ast.CallExpr {
+	var out []*ast.CallExpr
+	ast.Inspect(node, func(n ast.Node) bool {
+		if call, ok := n.(*ast.CallExpr); ok && selectorName(call.Fun) == name {
+			out = append(out, call)
+		}
+		return true
+	})
+	return out
+}
+func soleCall(t *testing.T, node ast.Node, name string) *ast.CallExpr {
+	t.Helper()
+	calls := callsNamed(node, name)
+	if len(calls) != 1 {
+		t.Fatalf("expected one %s call, got %d", name, len(calls))
+	}
+	return calls[0]
+}
+func TestPinnedBackupStoragePrecedesDeferredVolumeRowHook(t *testing.T) {
+	fn := pinnedMethod(t, "internal/server/storage/backend.go", "cb8275216f42b2685fd8a76718953dc4020975d6597de420c70721509d281b74", "CreateInstanceFromBackup")
+	native := soleCall(t, fn, "b.driver.CreateVolumeFromBackup")
+	var post *ast.FuncLit
+	ast.Inspect(fn, func(n ast.Node) bool {
+		a, ok := n.(*ast.AssignStmt)
+		if !ok {
+			return true
+		}
+		for i, l := range a.Lhs {
+			if id, ok := l.(*ast.Ident); ok && id.Name == "postHook" && i < len(a.Rhs) {
+				post, _ = a.Rhs[i].(*ast.FuncLit)
+			}
+		}
+		return true
+	})
+	if post == nil || native.Pos() >= post.Pos() {
+		t.Fatal("expected native storage before deferred post hook definition")
+	}
+	rows := callsNamed(post, "VolumeDBCreate")
+	if len(rows) != 2 {
+		t.Fatal("expected instance and snapshot volume row creation in post hook")
+	}
+	for _, row := range rows {
+		if row.Pos() <= native.Pos() {
+			t.Fatal("volume row precedes storage")
+		}
+	}
+	// AST nesting is important: the row call is in the returned closure, not an
+	// earlier transaction. This does NOT establish all callers or driver effects.
+	if len(callsNamed(fn, "instance.CreateInternal")) != 0 {
+		t.Fatal("revisit instance-row ordering")
+	}
+}
+func TestPinnedRebuildDeletesThenCreatesWithoutNewRowGrant(t *testing.T) {
+	fn := pinnedMethod(t, "internal/server/instance/drivers/driver_common.go", "4285ff9e2c791a85a6420da5abed139b5ec61edfa47f1033e3905e566d90a60f", "rebuildCommon")
+	remove := soleCall(t, fn, "pool.DeleteInstance")
+	empty := soleCall(t, fn, "pool.CreateInstance")
+	image := soleCall(t, fn, "pool.CreateInstanceFromImage")
+	update := soleCall(t, fn, "dbCluster.UpdateInstanceConfig")
+	if !(remove.Pos() < empty.Pos() && remove.Pos() < image.Pos() && empty.Pos() < update.Pos() && image.Pos() < update.Pos()) {
+		t.Fatal("rebuild ordering changed")
+	}
+	if len(callsNamed(fn, "instance.CreateInternal")) != 0 {
+		t.Fatal("revisit same-row rebuild premise")
+	}
+	// Sequential source ordering is not physical completion, especially when a
+	// deletion/create returns an error after side effects or loses its ACK.
+}
+func TestPinnedStopCallbackHasAsynchronousInternalMutations(t *testing.T) {
+	fn := pinnedMethod(t, "internal/server/instance/drivers/driver_lxc.go", "5d2502f80e72098decb5f57f2df644006e0a17c0f8a93f017a216a6dcf59fda8", "onStop")
+	var callback ast.Node
+	ast.Inspect(fn, func(n ast.Node) bool {
+		if goCall, ok := n.(*ast.GoStmt); ok && len(callsNamed(goCall, "d.Start")) > 0 {
+			if callback != nil {
+				t.Fatal("ambiguous callback")
+			}
+			callback = goCall
+		}
+		return true
+	})
+	if callback == nil {
+		t.Fatal("stop callback not found")
+	}
+	for name, arg := range map[string]string{"d.Start": "false", "d.delete": "true"} {
+		call := soleCall(t, callback, name)
+		if len(call.Args) != 1 || selectorName(call.Args[0]) != arg {
+			t.Fatal("internal mutation signature changed", name)
+		}
+	}
+	if len(callsNamed(callback, "d.Delete")) != 0 {
+		t.Fatal("revisit internal delete versus public Delete distinction")
+	}
+	// The callback is asynchronous and bypasses a new public HTTP request. The
+	// fact that we can inspect it is not authority to fence or charge it.
+}
diff --git a/qualification/nativefrontier/storage_attempt_test.go b/qualification/nativefrontier/storage_attempt_test.go
new file mode 100644
index 000000000..a0930e707
--- /dev/null
