@@ -0,0 +1,25 @@
+#!/bin/sh
+# Offline-prepared recipe. Requires a disposable Docker/Podman build worker.
+set -eu
+base=${1:?Usage: run.sh docker.io/library/debian@sha256:DIGEST}
+case "$base" in docker.io/library/debian@sha256:*) ;; *) echo 'Require official Debian image pinned by digest' >&2; exit 2;; esac
+digest=${base##*@sha256:}
+[ "${#digest}" -eq 64 ] && ! printf '%s' "$digest" | grep -q '[^0-9a-f]' || exit 2
+engine=${CONTAINER_ENGINE:-docker}
+case "$engine" in docker|podman) ;; *) echo 'Unsupported engine' >&2; exit 2;; esac
+command -v "$engine" >/dev/null
+root=$(git rev-parse --show-toplevel)
+[ "$(git -C "$root" rev-parse a99413afd0c742da3bba10eb4f75d639f9dbbd32^{commit})" = a99413afd0c742da3bba10eb4f75d639f9dbbd32 ]
+git -C "$root" merge-base --is-ancestor a99413afd0c742da3bba10eb4f75d639f9dbbd32 HEAD
+# Ensure none of the actual pinned upstream sources changed. Only qualification/
+# is permitted by this prototype. No untracked upstream files enter the context.
+[ -z "$(git -C "$root" diff --name-only a99413afd0c742da3bba10eb4f75d639f9dbbd32 HEAD -- . ':!qualification')" ]
+context=$(mktemp -d)
+trap 'rm -rf "$context"' EXIT HUP INT TERM
+git -C "$root" archive HEAD | tar -x -C "$context"
+# No host socket, credentials, devices, privileged mode, runtime or host mounts.
+# The build does access signed distro repositories and Go module downloads.
+"$engine" build --no-cache --build-arg "BASE_IMAGE=$base" \
+ -f "$context/qualification/nativebuild/Dockerfile" \
+ -t incus-native-frontier-compile-only:local "$context"
+printf '%s\n' 'Build success is compile-only plus fixture tests, NOT daemon validation.'
