+package cluster
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+)
+
+func guardRowFixture(t *testing.T) (*sql.DB, int64, string) {
+	t.Helper()
+	db := guardFixture(t)
+	guardEnableFixture(t, db)
+	if _, err := db.Exec(`INSERT INTO nodes(id,name,description,address,schema,api_extensions,arch) VALUES(999,'fixture','','fixture',73,1,1)`); err != nil {
+		t.Fatal(err)
+	}
+	var id int64
+	var token string
+	err := guardTx(db, func(tx *sql.Tx) error {
+		ctx := context.Background()
+		if err := guardBound(tx, "a"); err != nil {
+			return err
+		}
+		if err := guardReserveCreate(ctx, tx, "a", "fixture", 1, 999, "one"); err != nil {
+			return err
+		}
+		var err error
+		id, token, err = guardCreateRow(ctx, tx, "a", "fixture", 999, 1)
+		return err
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return db, id, token
+}
+func TestGuardNativeAttemptRetainedAfterRowCleanupAndReopen(t *testing.T) {
+	db, _, token := guardRowFixture(t)
+	ctx := context.Background()
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", token) }); err != nil {
+		t.Fatal(err)
+	}
+	// Simulates an unknown ACK: do not record return. No native I/O is executed.
+	if _, err := db.Exec(`DELETE FROM instances WHERE name='one'`); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "native.db")
+	if _, err := db.Exec(`VACUUM INTO ?`, path); err != nil {
+		t.Fatal(err)
+	}
+	re, err := sql.Open("sqlite3", path+"?_foreign_keys=1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer re.Close()
+	var n int
+	var outcome sql.NullString
+	if err = re.QueryRow(`SELECT count(*),observed_return FROM guard_storage_attempts`).Scan(&n, &outcome); err != nil || n != 1 || outcome.Valid {
+		t.Fatal(n, outcome, err)
+	}
+	if err = guardTx(re, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", token) }); err == nil {
+		t.Fatal("repeated unknown attempt")
+	}
+	if _, err = re.Exec(`DELETE FROM guard_row_history`); err == nil {
+		t.Fatal("history removed")
+	}
+	if _, err = re.Exec(`DELETE FROM guard_storage_attempts`); err == nil {
+		t.Fatal("attempt removed")
+	}
+}
+func TestGuardNativeIdentityMismatchAndSealDeny(t *testing.T) {
+	db, id, token := guardRowFixture(t)
+	ctx := context.Background()
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", "wrong") }); err == nil {
+		t.Fatal("wrong token accepted")
+	}
+	// Out-of-band SQL is an explicit unqualified writer, not an upstream behavior.
+	if _, err := db.Exec(`UPDATE instances SET guard_token='replacement' WHERE id=?`, id); err == nil {
+		t.Fatal("immutable token changed")
+	}
+	if _, err := db.Exec(`UPDATE instances SET name='renamed' WHERE id=?`, id); err != nil {
+		t.Fatal(err)
+	}
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", token) }); err == nil {
+		t.Fatal("renamed current identity accepted")
+	}
+	if _, err := db.Exec(`UPDATE instances SET name='one' WHERE id=?`, id); err != nil {
+		t.Fatal(err)
+	}
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardSeal(ctx, tx, 1) }); err != nil {
+		t.Fatal(err)
+	}
+	if err := guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", token) }); err == nil {
+		t.Fatal("new attempt after seal")
+	}
+}
+func TestGuardNativeReturnNeverReleasesOrReplays(t *testing.T) {
+	for _, result := range []string{"success", "error"} {
+		t.Run(result, func(t *testing.T) {
+			db, _, token := guardRowFixture(t)
+			ctx := context.Background()
+			if err := guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", token) }); err != nil {
+				t.Fatal(err)
+			}
+			if err := guardTx(db, func(tx *sql.Tx) error { return guardSeal(ctx, tx, 1) }); err != nil {
+				t.Fatal(err)
+			}
+			// A previously committed call can return after seal. Store receipt, not release.
+			if err := guardTx(db, func(tx *sql.Tx) error { return guardRecordStorageReturn(ctx, tx, "a", token, result) }); err != nil {
+				t.Fatal(err)
+			}
+			if err := guardTx(db, func(tx *sql.Tx) error { return guardRecordStorageReturn(ctx, tx, "a", token, result) }); err == nil {
+				t.Fatal("receipt overwritten")
+			}
+			var n int
+			if err := db.QueryRow(`SELECT count(*) FROM guard_create_scopes`).Scan(&n); err != nil || n != 1 {
+				t.Fatal(n, err)
+			}
+			if err := guardTx(db, func(tx *sql.Tx) error { return guardBeginStorage(ctx, tx, "a", "fixture", token) }); err == nil {
+				t.Fatal("attempt replayed")
+			}
+		})
+	}
+}
+func TestGuardNativeRowRollbackAndNoAdoption(t *testing.T) {
+	db, _, _ := guardRowFixture(t)
+	ctx := context.Background()
+	if err := guardTx(db, func(tx *sql.Tx) error { _, _, err := guardCreateRow(ctx, tx, "a", "fixture", 999, 1); return err }); err == nil {
+		t.Fatal("existing row adopted")
+	}
+	tx, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = guardBound(tx, "b"); err != nil {
+		t.Fatal(err)
+	}
+	if err = guardReserveCreate(ctx, tx, "b", "fixture", 1, 999, "two"); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = guardCreateRow(ctx, tx, "b", "fixture", 999, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err = tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	var n int
+	if err = db.QueryRow(`SELECT count(*) FROM instances WHERE name='two'`).Scan(&n); err != nil || n != 0 {
+		t.Fatal(n, err)
+	}
+	if err = db.QueryRow(`SELECT count(*) FROM guard_row_history WHERE request_id='b'`).Scan(&n); err != nil || n != 0 {
+		t.Fatal(n, err)
+	}
+}
