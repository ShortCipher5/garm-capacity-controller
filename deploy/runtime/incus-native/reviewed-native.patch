+package nativefrontier
+
+// Only the pinned backup import ERROR prefix is executed with fake storage.
+// A sentinel ends the fixture before all remaining import/posthook work. No
+// successful import, physical completion, or release protocol is implemented.
+import (
+	"errors"
+	"go/format"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/lxc/incus/v6/shared/revert"
+)
+
+var prefixStop = errors.New("fixture boundary before remaining import work")
+
+type backupInfo struct{ Project, Name string }
+type backupVolume struct{}
+
+func (backupVolume) MountPath() string { return "fixture-only" }
+
+type backupHarness struct {
+	driver       *backupDriver
+	symlinkError bool
+}
+type backupDriver struct {
+	physical                                 bool
+	beforeCallError, loseACK, cleanupFailure bool
+	calls, cleanupCalls                      int
+}
+
+func (d *backupDriver) CreateVolumeFromBackup(_ backupVolume, _ backupInfo, _ any, _ any) (func() error, revert.Hook, error) {
+	if d.beforeCallError {
+		return nil, nil, errors.New("intent unavailable before fixture I/O")
+	}
+	d.calls++
+	d.physical = true
+	cleanup := func() {
+		d.cleanupCalls++
+		if !d.cleanupFailure {
+			d.physical = false
+		}
+	}
+	if d.loseACK {
+		return nil, cleanup, errors.New("native backup return unknown")
+	}
+	return func() error { return nil }, cleanup, nil
+}
+func (b *backupHarness) ensureInstanceSymlink(_ any, _ string, _ string, _ string) error {
+	if b.symlinkError {
+		return errors.New("symlink stage failed")
+	}
+	return nil
+}
+
+// All statements through the symlink-error branch are pinned upstream source.
+// Only the signature/types and final sentinel are fixture scaffolding.
+func pinnedBackupErrorPrefix(b *backupHarness, vol backupVolume, srcBackup backupInfo, srcData any, op any, instanceType any) (func() error, revert.Hook, error) {
+	importRevert := revert.New()
+	defer importRevert.Fail()
+
+	// Unpack the backup into the new storage volume(s).
+	volPostHook, revertHook, err := b.driver.CreateVolumeFromBackup(vol, srcBackup, srcData, op)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	if revertHook != nil {
+		importRevert.Add(revertHook)
+	}
+
+	err = b.ensureInstanceSymlink(instanceType, srcBackup.Project, srcBackup.Name, vol.MountPath())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	_ = volPostHook
+	return nil, nil, prefixStop
+}
+func TestPinnedBackupErrorPrefixIdentity(t *testing.T) {
+	pinnedMethod(t, "internal/server/storage/backend.go", "cb8275216f42b2685fd8a76718953dc4020975d6597de420c70721509d281b74", "CreateInstanceFromBackup")
+	raw, err := os.ReadFile("../../internal/server/storage/backend.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	src := string(raw)
+	src = src[strings.Index(src, "func (b *backend) CreateInstanceFromBackup("):]
+	start := strings.Index(src, "importRevert := revert.New()")
+	end := strings.Index(src, "importRevert.Add(func()")
+	signature := "func pinnedBackupErrorPrefix(b *backupHarness,vol backupVolume,srcBackup backupInfo,srcData any,op any,instanceType any)(func()error,revert.Hook,error){\n"
+	expected, err := format.Source([]byte("package nativefrontier\n" + signature + src[start:end] + "_=volPostHook\nreturn nil,nil,prefixStop\n}"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	own, err := os.ReadFile("backup_prefix_test.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(own)
+	start = strings.Index(text, "func pinnedBackupErrorPrefix(")
+	end = strings.Index(text, "func TestPinnedBackupErrorPrefixIdentity(")
+	actual, err := format.Source([]byte("package nativefrontier\n" + text[start:end]))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(actual) != string(expected) {
+		t.Fatal("pinned backup error prefix changed")
+	}
+}
+func TestBackupDriverErrorBeforeRevertRegistrationLeavesStorage(t *testing.T) {
+	d := &backupDriver{loseACK: true}
+	b := &backupHarness{driver: d}
+	_, _, err := pinnedBackupErrorPrefix(b, backupVolume{}, backupInfo{}, nil, nil, nil)
+	if err == nil || err == prefixStop || !d.physical || d.calls != 1 || d.cleanupCalls != 0 {
+		t.Fatal("pre-registration lost ACK counterexample lost", d, err)
+	}
+	// A returned hook accompanied by error is not registered by this prefix.
+	// There is no instance/volume database row in this fixture at all.
+}
+func TestBackupRegisteredCleanupCannotCertifyAbsence(t *testing.T) {
+	d := &backupDriver{cleanupFailure: true}
+	b := &backupHarness{driver: d, symlinkError: true}
+	_, _, err := pinnedBackupErrorPrefix(b, backupVolume{}, backupInfo{}, nil, nil, nil)
+	if err == nil || err.Error() != "symlink stage failed" || !d.physical || d.cleanupCalls != 1 {
+		t.Fatal("void revert hook failure was mistaken for absence", d, err)
+	}
+}
+func TestBackupPrefixEarlyDeniedAttemptHasNoFixtureNativeEffect(t *testing.T) {
+	d := &backupDriver{beforeCallError: true}
+	b := &backupHarness{driver: d}
+	_, _, err := pinnedBackupErrorPrefix(b, backupVolume{}, backupInfo{}, nil, nil, nil)
+	if err == nil || d.physical || d.calls != 0 || d.cleanupCalls != 0 {
+		t.Fatal("early denial dispatched storage", d, err)
+	}
+	// This is an injected failure, NOT a durable no-row admission implementation.
+}
+func TestBackupPrefixStopsWithoutClaimingSuccessfulImport(t *testing.T) {
+	d := &backupDriver{}
+	b := &backupHarness{driver: d}
+	_, _, err := pinnedBackupErrorPrefix(b, backupVolume{}, backupInfo{}, nil, nil, nil)
+	if err != prefixStop || d.cleanupCalls != 1 || d.physical {
+		t.Fatal("prefix boundary bypassed", d, err)
+	}
+	// Success of the real remainder/posthook is intentionally not represented.
+}
