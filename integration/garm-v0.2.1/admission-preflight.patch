+package common
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func preparationFixture() PreparationRequest {
+	return PreparationRequest{Protocol: PreparationVersion, Name: "planned", PoolID: "pool", InstanceID: "11111111-1111-4111-8111-111111111111", AgentID: 42, Generation: 0, ProviderName: "capacity", EntityType: "repository", EntityID: "22222222-2222-4222-8222-222222222222", ForgeEndpointName: "fixture-forge", JITEnabled: true}
+}
+func runPreparationStub(mode string) {
+	raw, _ := io.ReadAll(os.Stdin)
+	request, err := DecodePreparationRequest(raw)
+	if err != nil {
+		os.Exit(2)
+	}
+	outcome := "recorded"
+	if os.Getenv("GARM_COMMAND") == "ValidatePreparation" {
+		outcome = "validated"
+	} else if os.Getenv("GARM_COMMAND") != "RecordPreparation" {
+		os.Exit(2)
+	}
+	if mode == "secret" {
+		fmt.Print("private-child-output")
+		fmt.Fprint(os.Stderr, "private-stderr")
+		os.Exit(1)
+	}
+	if mode == "oversized" {
+		fmt.Print(strings.Repeat("x", 4097))
+		os.Exit(0)
+	}
+	if mode == "wait" {
+		time.Sleep(time.Minute)
+		os.Exit(1)
+	}
+	replay, dispatched := outcome == "validated", false
+	response := PreparationResponse{PreparationRequest: request, Outcome: outcome, ReservationKey: strings.Repeat("a", 64), RecordSequence: 1, Replay: &replay, Dispatched: &dispatched}
+	switch mode {
+	case "changed-id":
+		response.AgentID++
+	case "dispatched":
+		dispatched = true
+	case "missing":
+		response.Replay = nil
+	case "wrong-outcome":
+		response.Outcome = "reserved"
+	}
+	_ = json.NewEncoder(os.Stdout).Encode(response)
+	if mode == "nonzero" {
+		os.Exit(75)
+	}
+	os.Exit(0)
+}
+func TestPreparationCommandRequiresExactBoundedDurableAcknowledgement(t *testing.T) {
+	for _, command := range []string{"RecordPreparation", "ValidatePreparation"} {
+		for _, mode := range []string{"valid", "changed-id", "dispatched", "missing", "wrong-outcome", "secret", "oversized", "nonzero"} {
+			t.Run(command+mode, func(t *testing.T) {
+				outcome := "recorded"
+				if command == "ValidatePreparation" {
+					outcome = "validated"
+				}
+				err := RunPreparationProvider(context.Background(), os.Args[0], []string{"GCC_PREPARATION_STUB=" + mode, "GARM_COMMAND=" + command}, preparationFixture(), outcome)
+				if (err == nil) != (mode == "valid") {
+					t.Fatal("incorrect receipt acceptance", err)
+				}
+				if err != nil && strings.Contains(err.Error(), "private") {
+					t.Fatal("private child output leaked")
+				}
+			})
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Millisecond)
+	defer cancel()
+	if RunPreparationProvider(ctx, os.Args[0], []string{"GCC_PREPARATION_STUB=wait", "GARM_COMMAND=RecordPreparation"}, preparationFixture(), "recorded") == nil {
+		t.Fatal("unknown receipt acknowledged")
+	}
+}
+func TestOriginalJITValidationRejectsMalformedPayloads(t *testing.T) {
+	for _, payload := range []string{`{"agentId":42,"agentName":"planned"}`, `{"agentId":42,"agentId":42,"agentName":"planned"}`, `{"agentId":null,"agentName":"planned"}`, `{"agentId":42,"AgentName":"planned"}`, `{"agentId":42,"agentName":"wrong"}`, `{"agentId":42.0,"agentName":"planned"}`} {
+		encoded := base64.StdEncoding.EncodeToString([]byte(payload))
+		err := ValidateOriginalJITIdentity("planned", 42, map[string]string{".runner": encoded})
+		if (err == nil) != (payload == `{"agentId":42,"agentName":"planned"}`) {
+			t.Fatal("wrong payload identity accepted")
+		}
+	}
+}
