+++ b/runner/common/admission_test.go
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: Apache-2.0
+package common
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// TestMain is an executable provider stub when called by these tests. It never
+// contacts a provider, a controller, GitHub or infrastructure.
+func TestMain(m *testing.M) {
+	if mode := os.Getenv("GCC_CANCELLATION_STUB"); mode != "" {
+		runCancellationStub(mode)
+		return
+	}
+	if mode := os.Getenv("GCC_ADMISSION_STUB"); mode != "" {
+		input, _ := io.ReadAll(os.Stdin)
+		if mode == "echo-secret-failure" {
+			fmt.Printf("stdout:%s", input)
+			fmt.Fprintf(os.Stderr, "stderr:%s", input)
+			os.Exit(1)
+		}
+		var request struct {
+			Protocol string `json:"protocol"`
+			Name     string `json:"name"`
+			PoolID   string `json:"pool_id"`
+		}
+		if json.Unmarshal(input, &request) != nil || request.Protocol != AdmissionProtocolVersion || os.Getenv("GARM_COMMAND") != "AdmitInstance" {
+			os.Exit(9)
+		}
+		var fields map[string]any
+		_ = json.Unmarshal(input, &fields)
+		if len(fields) != 3 {
+			os.Exit(10)
+		}
+		if mode == "oversize" {
+			fmt.Print(strings.Repeat("x", admissionMaximumResponseBytes+1))
+			os.Exit(75)
+		}
+		if mode == "malformed" {
+			fmt.Print("secret-must-not-echo")
+			os.Exit(75)
+		}
+		if mode == "cancel" {
+			time.Sleep(time.Minute)
+			os.Exit(1)
+		}
+		response := map[string]any{"protocol": AdmissionProtocolVersion, "outcome": "deferred", "name": request.Name, "pool_id": request.PoolID, "dispatched": false, "retry_after_seconds": 10}
+		exit := AdmissionDeferredExitCode
+		switch mode {
+		case "reserved":
+			response["outcome"] = "reserved"
+			delete(response, "retry_after_seconds")
+			response["reservation_key"] = "reservation-1"
+			exit = 0
+		case "wrong-exit":
+			exit = 0
+		case "dispatched":
+			response["dispatched"] = true
+		case "wrong-identity":
+			response["name"] = "someone-else"
+		case "stderr":
+			fmt.Fprint(os.Stderr, "secret-must-not-echo")
+		}
+		_ = json.NewEncoder(os.Stdout).Encode(response)
+		os.Exit(exit)
+	}
+	os.Exit(m.Run())
+}
+
+func TestAdmissionExecutableBoundary(t *testing.T) {
+	request := AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	for _, mode := range []string{"deferred", "reserved", "stderr"} {
+		err := RunAdmissionProvider(context.Background(), os.Args[0], []string{"GCC_ADMISSION_STUB=" + mode, "GARM_COMMAND=AdmitInstance"}, request)
+		if mode == "reserved" {
+			if err != nil {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if !IsAdmissionDeferred(err) || AdmissionRetryAfter(err) != 10*time.Second {
+			t.Fatalf("%s: %v", mode, err)
+		}
+		if strings.Contains(err.Error(), "secret-must-not-echo") {
+			t.Fatal("stderr leaked")
+		}
+	}
+}
+
+func TestAdmissionMalformedAndUncertainResultsFailClosed(t *testing.T) {
+	for _, mode := range []string{"oversize", "malformed", "wrong-exit", "dispatched", "wrong-identity"} {
+		err := RunAdmissionProvider(context.Background(), os.Args[0], []string{"GCC_ADMISSION_STUB=" + mode, "GARM_COMMAND=AdmitInstance"}, AdmissionRequest{Name: "runner-1", PoolID: "pool-1"})
+		if err == nil || IsAdmissionDeferred(err) || strings.Contains(err.Error(), "secret-must-not-echo") {
+			t.Fatalf("unsafe %s result: %v", mode, err)
+		}
+	}
+}
+
+func TestAdmissionCancellationIsNotDeferral(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	defer cancel()
+	err := RunAdmissionProvider(ctx, os.Args[0], []string{"GCC_ADMISSION_STUB=cancel", "GARM_COMMAND=AdmitInstance"}, AdmissionRequest{Name: "runner-1", PoolID: "pool-1"})
+	if !errors.Is(err, context.DeadlineExceeded) || IsAdmissionDeferred(err) {
+		t.Fatalf("cancellation misclassified: %v", err)
+	}
+}
+
+func TestAdmissionOutputIsBoundedAndDrained(t *testing.T) {
+	output := &admissionOutput{}
+	count, err := io.Copy(output, strings.NewReader(strings.Repeat("x", admissionMaximumResponseBytes*4)))
+	if err != nil || count != int64(admissionMaximumResponseBytes*4) || !output.overflow || output.Len() != admissionMaximumResponseBytes {
+		t.Fatal("unbounded or undrained output")
+	}
+}
+
+func TestSensitiveCreateFailureDoesNotDiscloseBootstrap(t *testing.T) {
+	secret := "bootstrap-secret-must-not-echo"
+	out, err := RunProviderCommand(context.Background(), os.Args[0], []string{"GCC_ADMISSION_STUB=echo-secret-failure"}, []byte(secret))
+	if err == nil || out != nil || IsAdmissionDeferred(err) || strings.Contains(err.Error(), secret) {
+		t.Fatalf("unsafe create failure: %v", err)
+	}
+}
+
+func TestAdmissionRejectsDuplicateAndUnknownProtocolKeys(t *testing.T) {
+	for _, payload := range []string{
+		`{"protocol":"garm-capacity/v1","outcome":"deferred","name":"runner-1","pool_id":"pool-1","dispatched":true,"dispatched":false,"retry_after_seconds":10}`,
+		`{"Protocol":"garm-capacity/v1","outcome":"deferred","name":"runner-1","pool_id":"pool-1","dispatched":false,"retry_after_seconds":10}`,
+	} {
+		if _, err := parseAdmissionResponse(75, []byte(payload), AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}); err == nil {
+			t.Fatal("ambiguous keys accepted")
+		}
+	}
+}
