+func runExternalCancellationStub(mode string) {
+	input, _ := io.ReadAll(os.Stdin)
+	if mode == "secret" {
+		fmt.Printf("%s", input)
+		fmt.Fprint(os.Stderr, "external-secret-must-not-echo")
+		os.Exit(1)
+	}
+	var request map[string]any
+	if json.Unmarshal(input, &request) != nil || len(request) != 3 || request["protocol"] != common.AdmissionProtocolVersion || os.Getenv("GARM_COMMAND") != "CancelAdmission" || os.Getenv("GARM_CONTROLLER_ID") != "test-controller" || os.Getenv("GARM_POOL_ID") != "pool-1" || os.Getenv("GARM_PROVIDER_CONFIG_FILE") != "/fixture/provider.json" || os.Getenv("GARM_INTERFACE_VERSION") != "v0.1.1" {
+		os.Exit(9)
+	}
+	replay := mode == "replay"
+	_ = json.NewEncoder(os.Stdout).Encode(map[string]any{"protocol": common.AdmissionProtocolVersion, "outcome": "cancelled", "name": request["name"], "pool_id": request["pool_id"], "dispatched": false, "reservation_key": "reservation-1", "replay": replay})
+	os.Exit(0)
+}
+func TestOptionalCancellationUsesTrustedEnvironmentAndNoLegacyExecution(t *testing.T) {
+	cfg := &config.Provider{External: config.External{AdmissionEnabled: false, ConfigFile: "/fixture/provider.json"}}
+	provider := &external{cfg: cfg, controllerID: "test-controller", execPath: "/must-not-run"}
+	request := common.AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	if err := provider.CancelAdmission(context.Background(), request); err != nil {
+		t.Fatal("legacy behavior changed")
+	}
+	cfg.External.AdmissionEnabled = true
+	provider.execPath = os.Args[0]
+	for _, mode := range []string{"success", "replay", "secret"} {
+		provider.environmentVariables = []string{"GARM_INTERFACE_VERSION=v0.1.1", "GCC_EXTERNAL_CANCELLATION_STUB=" + mode}
+		err := provider.CancelAdmission(context.Background(), request)
+		if (err == nil) != (mode != "secret") || common.IsAdmissionDeferred(err) {
+			t.Fatalf("unsafe cancellation result: %v", err)
+		}
+		if err != nil && strings.Contains(err.Error(), "secret") {
+			t.Fatal("child output disclosed")
+		}
+	}
+}
