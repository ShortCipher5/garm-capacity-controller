+package controllers
+
+import (
+	"bytes"
+	"context"
+	"database/sql"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/cloudbase/garm/config"
+	"github.com/cloudbase/garm/database"
+	"github.com/cloudbase/garm/database/watcher"
+	garmTesting "github.com/cloudbase/garm/internal/testing"
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner"
+	"github.com/cloudbase/garm/runner/common"
+	"github.com/gorilla/mux"
+	"github.com/stretchr/testify/require"
+)
+
+// These are the actual HTTP controllers and public Runner API over real SQLite.
+// Authentication middleware is NOT under test: requests have a fixture admin
+// context. No pool manager is started, and provider executables are never run.
+func TestGatewayBootstrapExplicitZeroHTTPEnrollmentAndLegacySemantics(t *testing.T) {
+	watcher.SetWatcher(&garmTesting.MockWatcher{})
+	ctx := context.Background()
+	dbConfig := garmTesting.GetTestSqliteDBConfig(t)
+	store, err := database.NewDatabase(ctx, dbConfig)
+	require.NoError(t, err)
+	admin := garmTesting.ImpersonateAdminContext(ctx, store, t)
+	_, err = store.InitController()
+	require.NoError(t, err)
+	provider := func(name, mode string, enabled bool) config.Provider {
+		return config.Provider{Name: name, ProviderType: params.ExternalProvider, External: config.External{InterfaceVersion: "v0.1.1", AdmissionEnabled: enabled, CapacityBootstrapMode: mode, ProviderExecutable: "/disposable-never-executed-provider"}}
+	}
+	// Construct against an empty entity set, so startup cannot create pool managers.
+	actual, err := runner.NewRunner(ctx, config.Config{Providers: []config.Provider{provider("capacity", common.CapacityBootstrapMode, true), provider("legacy", "", false), provider("unsupported", "wrong-mode", true)}}, store, nil)
+	require.NoError(t, err)
+	// Construct the later opted-in configuration while the entity set is still
+	// empty. Enrollment itself still goes through the real public HTTP handler.
+	enrolledRunner, err := runner.NewRunner(ctx, config.Config{Providers: []config.Provider{provider("legacy", common.CapacityBootstrapMode, true)}}, store, nil)
+	require.NoError(t, err)
+	endpoint := garmTesting.CreateDefaultGithubEndpoint(admin, store, t)
+	creds := garmTesting.CreateTestGithubCredentials(admin, "disposable-creds", store, t, endpoint)
+	repo, err := store.CreateRepository(admin, "disposable-owner", "disposable-repo", creds, "disposable-webhook", params.PoolBalancerTypeRoundRobin, false)
+	require.NoError(t, err)
+	tpl, err := store.CreateTemplate(admin, params.CreateTemplateParams{Name: "disposable-default", Data: []byte("not-executed"), OSType: "linux", ForgeType: params.GithubEndpointType, IsSystem: true})
+	require.NoError(t, err)
+	api, err := NewAPIController(actual, nil, nil, nil, nil, config.APIServer{})
+	require.NoError(t, err)
+	sqlDB, err := sql.Open("sqlite3", dbConfig.SQLite.DBFile)
+	require.NoError(t, err)
+	defer sqlDB.Close()
+	create := func(providerName string, template any, extra any) (*httptest.ResponseRecorder, params.Pool) {
+		body := map[string]any{"provider_name": providerName, "max_runners": 2, "min_idle_runners": 0, "image": "linux", "flavor": "small", "os_type": "linux", "os_arch": "amd64", "tags": []string{"linux"}, "extra_specs": extra}
+		if template != nil {
+			body["template_id"] = template
+		}
+		raw, _ := json.Marshal(body)
+		request := httptest.NewRequest(http.MethodPost, "http://example.invalid/repositories/"+repo.ID+"/pools", bytes.NewReader(raw)).WithContext(admin)
+		request = mux.SetURLVars(request, map[string]string{"repoID": repo.ID})
+		response := httptest.NewRecorder()
+		api.CreateRepoPoolHandler(response, request)
+		var pool params.Pool
+		if response.Code == http.StatusOK {
+			require.NoError(t, json.Unmarshal(response.Body.Bytes(), &pool))
+		}
+		return response, pool
+	}
+	update := func(id string, body map[string]any, entity bool) (*httptest.ResponseRecorder, params.Pool) {
+		raw, _ := json.Marshal(body)
+		request := httptest.NewRequest(http.MethodPut, "http://example.invalid/pools/"+id, bytes.NewReader(raw)).WithContext(admin)
+		request = mux.SetURLVars(request, map[string]string{"repoID": repo.ID, "poolID": id})
+		response := httptest.NewRecorder()
+		if entity {
+			api.UpdateRepoPoolHandler(response, request)
+		} else {
+			api.UpdatePoolByIDHandler(response, request)
+		}
+		var pool params.Pool
+		if response.Code == http.StatusOK {
+			require.NoError(t, json.Unmarshal(response.Body.Bytes(), &pool))
+		}
+		return response, pool
+	}
+	nullTemplate := func(id string, wantNull bool) {
+		var actual sql.NullInt64
+		require.NoError(t, sqlDB.QueryRow("SELECT template_id FROM pools WHERE id=?", id).Scan(&actual))
+		require.Equal(t, !wantNull, actual.Valid)
+	}
+	response, pool := create("capacity", 0, map[string]any{})
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	require.Zero(t, pool.TemplateID)
+	nullTemplate(pool.ID, true)
+	response, pool = update(pool.ID, map[string]any{"template_id": 0}, true)
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	nullTemplate(pool.ID, true)
+	org, err := store.CreateOrganization(admin, "disposable-org", creds, "disposable-webhook", params.PoolBalancerTypeRoundRobin, false)
+	require.NoError(t, err)
+	enterprise, err := store.CreateEnterprise(admin, "disposable-enterprise", creds, "disposable-webhook", params.PoolBalancerTypeRoundRobin, false)
+	require.NoError(t, err)
+	for _, scope := range []struct {
+		id, key        string
+		create, update http.HandlerFunc
+	}{{org.ID, "orgID", api.CreateOrgPoolHandler, api.UpdateOrgPoolHandler}, {enterprise.ID, "enterpriseID", api.CreateEnterprisePoolHandler, api.UpdateEnterprisePoolHandler}} {
+		body := map[string]any{"provider_name": "capacity", "template_id": 0, "max_runners": 2, "min_idle_runners": 0, "image": "linux", "flavor": "small", "os_type": "linux", "os_arch": "amd64", "tags": []string{"linux"}, "extra_specs": map[string]any{}}
+		raw, _ := json.Marshal(body)
+		request := httptest.NewRequest(http.MethodPost, "http://example.invalid/disposable/pools", bytes.NewReader(raw)).WithContext(admin)
+		request = mux.SetURLVars(request, map[string]string{scope.key: scope.id})
+		response := httptest.NewRecorder()
+		scope.create(response, request)
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		var created params.Pool
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &created))
+		nullTemplate(created.ID, true)
+		request = httptest.NewRequest(http.MethodPut, "http://example.invalid/disposable/pools", bytes.NewBufferString(`{"template_id":0}`)).WithContext(admin)
+		request = mux.SetURLVars(request, map[string]string{scope.key: scope.id, "poolID": created.ID})
+		response = httptest.NewRecorder()
+		scope.update(response, request)
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		nullTemplate(created.ID, true)
+	}
+
+	// Existing legacy default/nonzero selection remains unchanged.
+	response, legacy := create("legacy", nil, map[string]any{})
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	require.NotZero(t, legacy.TemplateID)
+	defaultTemplate, err := store.GetTemplate(admin, legacy.TemplateID)
+	require.NoError(t, err)
+	require.Equal(t, "github_linux", defaultTemplate.Name)
+	nullTemplate(legacy.ID, false)
+	response, explicit := create("legacy", tpl.ID, map[string]any{})
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	require.Equal(t, tpl.ID, explicit.TemplateID)
+	response, _ = create("legacy", 0, map[string]any{})
+	require.NotEqual(t, http.StatusOK, response.Code)
+	response, _ = update(legacy.ID, map[string]any{"template_id": 0}, false)
+	require.NotEqual(t, http.StatusOK, response.Code)
+	nullTemplate(legacy.ID, false)
+	// A forged internal flag cannot clear a legacy template through public JSON.
+	response, _ = update(legacy.ID, map[string]any{"CapacityTemplateClear": true, "capacity_template_clear": true}, false)
+	require.Equal(t, http.StatusOK, response.Code)
+	nullTemplate(legacy.ID, false)
+	// Explicit capacity opt-in, not template ID alone, permits SQL NULL enrollment.
+	var beforeInvalid int
+	require.NoError(t, sqlDB.QueryRow("SELECT COUNT(*) FROM pools").Scan(&beforeInvalid))
+	for _, item := range []struct {
+		provider string
+		template any
+		extra    any
+	}{{"capacity", nil, map[string]any{}}, {"capacity", tpl.ID, map[string]any{}}, {"capacity", 0, map[string]any{"runner_install_template": "not-allowed"}}, {"capacity", 0, map[string]any{"limits.cpu": "99"}}, {"unsupported", 0, map[string]any{}}} {
+		response, _ = create(item.provider, item.template, item.extra)
+		require.NotEqual(t, http.StatusOK, response.Code)
+		var afterInvalid int
+		require.NoError(t, sqlDB.QueryRow("SELECT COUNT(*) FROM pools").Scan(&afterInvalid))
+		require.Equal(t, beforeInvalid, afterInvalid)
+	}
+	response, _ = update(pool.ID, map[string]any{"template_id": tpl.ID}, false)
+	require.NotEqual(t, http.StatusOK, response.Code)
+	nullTemplate(pool.ID, true)
+	response, _ = update(pool.ID, map[string]any{"extra_specs": map[string]any{"runner_install_template": "not-allowed"}}, true)
+	require.NotEqual(t, http.StatusOK, response.Code)
+	nullTemplate(pool.ID, true)
+
+	// A pool legitimately created through the legacy public API can be explicitly
+	// enrolled after the trusted provider configuration changes. No direct SQL edit.
+	enrollmentAPI, err := NewAPIController(enrolledRunner, nil, nil, nil, nil, config.APIServer{})
+	require.NoError(t, err)
+	api = enrollmentAPI
+	response, enrolled := update(legacy.ID, map[string]any{"template_id": 0, "extra_specs": map[string]any{}}, false)
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	require.Zero(t, enrolled.TemplateID)
+	nullTemplate(legacy.ID, true)
+	require.Greater(t, enrolled.Generation, legacy.Generation)
+}
