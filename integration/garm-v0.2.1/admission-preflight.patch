+//go:build testing
+
+package pool
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/google/go-github/v84/github"
+	"github.com/stretchr/testify/mock"
+	"github.com/cloudbase/garm/runner/common"
+)
+
+type admissionTestProvider struct {
+	common.Provider
+	result error
+	requests []common.AdmissionRequest
+}
+func (p *admissionTestProvider) AdmitInstance(_ context.Context, request common.AdmissionRequest) error {
+	p.requests = append(p.requests, request)
+	return p.result
+}
+
+func (s *PoolStressTestSuite) TestAdmissionBeforeJITAndPersistence() {
+	gate := &admissionTestProvider{Provider:s.providerMock, result:common.NewAdmissionDeferred(5*time.Second)}
+	s.mgr.providers[s.pool.ProviderName] = gate
+	err := s.mgr.AddRunner(s.adminCtx, s.pool.ID, nil)
+	s.Require().True(common.IsAdmissionDeferred(err))
+	rows, err := s.store.ListPoolInstances(s.adminCtx, s.pool.ID, false)
+	s.Require().NoError(err)
+	s.Empty(rows)
+	s.Require().Len(gate.requests, 1)
+	s.Equal(s.pool.ID, gate.requests[0].PoolID)
+	s.NotEmpty(gate.requests[0].Name)
+	s.Empty(s.ghcliMock.Calls)
+	s.Empty(s.providerMock.Calls)
+
+	// Unexpected failures remain failures, and still cannot allocate JIT or runners.
+	ordinary := errors.New("admission transport unavailable")
+	gate.result = ordinary
+	s.ErrorIs(s.mgr.AddRunner(s.adminCtx, s.pool.ID, nil), ordinary)
+	s.Empty(s.ghcliMock.Calls)
+	s.Empty(s.providerMock.Calls)
+
+	gate.result = nil
+	s.providerMock.On("DisableJITConfig").Return(false).Once()
+	s.ghcliMock.On("GetEntityJITConfig", mock.Anything, mock.Anything, mock.Anything, mock.Anything).
+		Return(map[string]string{"test":"fresh-jit"}, &github.Runner{ID:github.Int64(42)}, nil).Once()
+	s.Require().NoError(s.mgr.AddRunner(s.adminCtx, s.pool.ID, nil))
+	rows, err = s.store.ListPoolInstances(s.adminCtx, s.pool.ID, false)
+	s.Require().NoError(err)
+	s.Require().Len(rows, 1)
+	s.Equal(gate.requests[2].Name, rows[0].Name)
+	s.NotEqual(gate.requests[0].Name, rows[0].Name)
+	s.Equal(1, rows[0].CreateAttempt)
+	s.Equal(int64(42), rows[0].AgentID)
+	s.providerMock.AssertNotCalled(s.T(), "CreateInstance", mock.Anything, mock.Anything, mock.Anything)
+	s.providerMock.AssertNotCalled(s.T(), "DeleteInstance", mock.Anything, mock.Anything, mock.Anything)
+}
