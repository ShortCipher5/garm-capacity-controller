+package config
+
+import (
+	"os"
+	"testing"
+)
+
+func TestCapacityBootstrapModeRequiresExplicitPairedAdmissionOptIn(t *testing.T) {
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, item := range []struct {
+		admission bool
+		mode      string
+		valid     bool
+	}{{false, "", true}, {true, "", false}, {true, "unknown", false}, {false, "gateway-owned-default-cloudinit/v1", false}, {true, "gateway-owned-default-cloudinit/v1", true}} {
+		cfg := External{AdmissionEnabled: item.admission, CapacityBootstrapMode: item.mode, InterfaceVersion: "v0.1.1", ProviderExecutable: executable}
+		if (cfg.Validate() == nil) != item.valid {
+			t.Fatal("bootstrap mode pairing accepted/rejected incorrectly", item)
+		}
+	}
+}
