+	s.providerMock.On("DisableJITConfig").Return(false).Once()
+	s.ghcliMock.On("GetEntityJITConfig", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Run(func(mock.Arguments) { cancel() }).Return(map[string]string(nil), (*github.Runner)(nil), failure).Once()
