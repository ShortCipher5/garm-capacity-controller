+)
+
+// TestMain is an executable provider stub when called by these tests. It never
+// contacts a provider, a controller, GitHub or infrastructure.
+func TestMain(m *testing.M) {
+	if mode := os.Getenv("GCC_PREPARATION_STUB"); mode != "" {
+		runPreparationStub(mode)
+		return
+	}
+
+	if mode := os.Getenv("GCC_CANCELLATION_STUB"); mode != "" {
+		runCancellationStub(mode)
+		return
+	}
+	if mode := os.Getenv("GCC_ADMISSION_STUB"); mode != "" {
+		input, _ := io.ReadAll(os.Stdin)
+		if mode == "echo-secret-failure" {
+			fmt.Printf("stdout:%s", input)
+			fmt.Fprintf(os.Stderr, "stderr:%s", input)
+			os.Exit(1)
+		}
+		var request struct {
+			Protocol string `json:"protocol"`
+			Name     string `json:"name"`
+			PoolID   string `json:"pool_id"`
+		}
+		if json.Unmarshal(input, &request) != nil || request.Protocol != AdmissionProtocolVersion || os.Getenv("GARM_COMMAND") != "AdmitInstance" {
+			os.Exit(9)
+		}
+		var fields map[string]any
+		_ = json.Unmarshal(input, &fields)
+		if len(fields) != 3 {
+			os.Exit(10)
+		}
+		if mode == "oversize" {
+			fmt.Print(strings.Repeat("x", admissionMaximumResponseBytes+1))
+			os.Exit(75)
+		}
+		if mode == "malformed" {
+			fmt.Print("secret-must-not-echo")
+			os.Exit(75)
+		}
+		if mode == "cancel" {
+			time.Sleep(time.Minute)
+			os.Exit(1)
+		}
+		response := map[string]any{"protocol": AdmissionProtocolVersion, "outcome": "deferred", "name": request.Name, "pool_id": request.PoolID, "dispatched": false, "retry_after_seconds": 10}
+		exit := AdmissionDeferredExitCode
+		switch mode {
+		case "reserved":
+			response["outcome"] = "reserved"
+			delete(response, "retry_after_seconds")
+			response["reservation_key"] = "reservation-1"
+			exit = 0
+		case "wrong-exit":
+			exit = 0
+		case "dispatched":
+			response["dispatched"] = true
+		case "wrong-identity":
+			response["name"] = "someone-else"
+		case "stderr":
+			fmt.Fprint(os.Stderr, "secret-must-not-echo")
+		}
+		_ = json.NewEncoder(os.Stdout).Encode(response)
+		os.Exit(exit)
+	}
+	os.Exit(m.Run())
+}
+
+func TestAdmissionExecutableBoundary(t *testing.T) {
+	request := AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	for _, mode := range []string{"deferred", "reserved", "stderr"} {
+		err := RunAdmissionProvider(context.Background(), os.Args[0], []string{"GCC_ADMISSION_STUB=" + mode, "GARM_COMMAND=AdmitInstance"}, request)
+		if mode == "reserved" {
+			if err != nil {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if !IsAdmissionDeferred(err) || AdmissionRetryAfter(err) != 10*time.Second {
+			t.Fatalf("%s: %v", mode, err)
+		}
+		if strings.Contains(err.Error(), "secret-must-not-echo") {
+			t.Fatal("stderr leaked")
+		}
+	}
+}
+
+func TestAdmissionMalformedAndUncertainResultsFailClosed(t *testing.T) {
+	for _, mode := range []string{"oversize", "malformed", "wrong-exit", "dispatched", "wrong-identity"} {
+		err := RunAdmissionProvider(context.Background(), os.Args[0], []string{"GCC_ADMISSION_STUB=" + mode, "GARM_COMMAND=AdmitInstance"}, AdmissionRequest{Name: "runner-1", PoolID: "pool-1"})
+		if err == nil || IsAdmissionDeferred(err) || strings.Contains(err.Error(), "secret-must-not-echo") {
+			t.Fatalf("unsafe %s result: %v", mode, err)
+		}
+	}
+}
+
+func TestAdmissionCancellationIsNotDeferral(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	defer cancel()
+	err := RunAdmissionProvider(ctx, os.Args[0], []string{"GCC_ADMISSION_STUB=cancel", "GARM_COMMAND=AdmitInstance"}, AdmissionRequest{Name: "runner-1", PoolID: "pool-1"})
+	if !errors.Is(err, context.DeadlineExceeded) || IsAdmissionDeferred(err) {
+		t.Fatalf("cancellation misclassified: %v", err)
+	}
+}
+
+func TestAdmissionOutputIsBoundedAndDrained(t *testing.T) {
+	output := &admissionOutput{}
+	count, err := io.Copy(output, strings.NewReader(strings.Repeat("x", admissionMaximumResponseBytes*4)))
+	if err != nil || count != int64(admissionMaximumResponseBytes*4) || !output.overflow || output.Len() != admissionMaximumResponseBytes {
+		t.Fatal("unbounded or undrained output")
+	}
+}
+
+func TestSensitiveCreateFailureDoesNotDiscloseBootstrap(t *testing.T) {
+	secret := "bootstrap-secret-must-not-echo"
+	out, err := RunProviderCommand(context.Background(), os.Args[0], []string{"GCC_ADMISSION_STUB=echo-secret-failure"}, []byte(secret))
+	if err == nil || out != nil || IsAdmissionDeferred(err) || strings.Contains(err.Error(), secret) {
+		t.Fatalf("unsafe create failure: %v", err)
+	}
+}
+
+func TestAdmissionRejectsDuplicateAndUnknownProtocolKeys(t *testing.T) {
+	for _, payload := range []string{
+		`{"protocol":"garm-capacity/v1","outcome":"deferred","name":"runner-1","pool_id":"pool-1","dispatched":true,"dispatched":false,"retry_after_seconds":10}`,
+		`{"Protocol":"garm-capacity/v1","outcome":"deferred","name":"runner-1","pool_id":"pool-1","dispatched":false,"retry_after_seconds":10}`,
+	} {
+		if _, err := parseAdmissionResponse(75, []byte(payload), AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}); err == nil {
+			t.Fatal("ambiguous keys accepted")
+		}
+	}
+}
diff --git a/runner/common/preparation.go b/runner/common/preparation.go
new file mode 100644
index 0000000..32ea6bd
--- /dev/null
+++ b/runner/common/preparation.go
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package common
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+	"github.com/cloudbase/garm/params"
+	"io"
+	"math"
+	"os/exec"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const PreparationVersion = "garm-capacity-preparation/v1"
+
+var ErrPreparationProtocol = errors.New("invalid preparation protocol")
+
+// PreparationRequest contains NONSECRET original source metadata only. The
+// controller, source scope and authenticated issuer are derived at the server.
+// No JIT configuration, JWT, bootstrap token or credentials belong here.
+type PreparationRequest struct {
+	Protocol          string `json:"protocol"`
+	Name              string `json:"name"`
+	PoolID            string `json:"pool_id"`
+	InstanceID        string `json:"instance_id"`
+	AgentID           int64  `json:"agent_id"`
+	Generation        uint64 `json:"generation"`
+	ProviderName      string `json:"provider_name"`
+	EntityType        string `json:"entity_type"`
+	EntityID          string `json:"entity_id"`
+	ForgeEndpointName string `json:"forge_endpoint_name"`
+	JITEnabled        bool   `json:"jit_enabled"`
+}
+
+// PreparationResponse is a durable metadata acknowledgement or lookup, NEVER a
+// physical dispatch/absence/release permit. Replay cannot change its identity.
+type PreparationResponse struct {
+	PreparationRequest
+	Outcome        string `json:"outcome"`
+	ReservationKey string `json:"reservation_key"`
+	RecordSequence int64  `json:"record_sequence"`
+	Replay         *bool  `json:"replay"`
+	Dispatched     *bool  `json:"dispatched"`
+}
+
+var preparationRequestKeys = []string{"protocol", "name", "pool_id", "instance_id", "agent_id", "generation", "provider_name", "entity_type", "entity_id", "forge_endpoint_name", "jit_enabled"}
+
+func canonicalPreparationUUID(value string, random bool) bool {
+	if len(value) != 36 || value == "00000000-0000-0000-0000-000000000000" {
+		return false
+	}
+	for i, r := range value {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if r != '-' {
+				return false
+			}
+		} else if !((r >= '0' && r <= '9') || (r >= 'a' && r <= 'f')) {
+			return false
+		}
+	}
+	return !random || (value[14] == '4' && strings.ContainsRune("89ab", rune(value[19])))
+}
+func preparationIdentity(value string) bool {
+	return validAdmissionIdentity(value) && strings.TrimSpace(value) == value
+}
+func (r PreparationRequest) Validate() error {
+	if r.Protocol != PreparationVersion || !preparationIdentity(r.Name) || !preparationIdentity(r.PoolID) || !preparationIdentity(r.ProviderName) || len(r.ProviderName) > 128 || !canonicalPreparationUUID(r.InstanceID, true) || !canonicalPreparationUUID(r.EntityID, false) || (!preparationIdentity(r.ForgeEndpointName) || len(r.ForgeEndpointName) > 128) || r.Generation > math.MaxInt64 {
+		return ErrPreparationProtocol
+	}
+	if r.EntityType != "repository" && r.EntityType != "organization" && r.EntityType != "enterprise" {
+		return ErrPreparationProtocol
+	}
+	if (r.JITEnabled && r.AgentID <= 0) || (!r.JITEnabled && r.AgentID != 0) {
+		return ErrPreparationProtocol
+	}
+	return nil
+}
+func exactPreparationObject(data []byte, keys []string) bool {
+	if len(data) == 0 || len(data) > admissionMaximumResponseBytes || !utf8.Valid(data) {
+		return false
+	}
+	allowed := map[string]bool{}
+	for _, key := range keys {
+		allowed[key] = true
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return false
+	}
+	seen := map[string]bool{}
+	for decoder.More() {
+		token, err := decoder.Token()
+		if err != nil {
+			return false
+		}
+		key, ok := token.(string)
+		if !ok || !allowed[key] || seen[key] {
+			return false
+		}
+		seen[key] = true
+		var raw json.RawMessage
+		if decoder.Decode(&raw) != nil || bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+			return false
+		}
+	}
+	token, err = decoder.Token()
+	if err != nil || token != json.Delim('}') || len(seen) != len(allowed) {
+		return false
+	}
+	return decoder.Decode(new(any)) == io.EOF
+}
+func DecodePreparationRequest(data []byte) (PreparationRequest, error) {
+	if !exactPreparationObject(data, preparationRequestKeys) {
+		return PreparationRequest{}, ErrPreparationProtocol
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var r PreparationRequest
+	if decoder.Decode(&r) != nil || decoder.Decode(new(any)) != io.EOF || r.Validate() != nil {
+		return PreparationRequest{}, ErrPreparationProtocol
+	}
+	return r, nil
+}
+func EncodePreparationRequest(r PreparationRequest) ([]byte, error) {
+	if r.Validate() != nil {
+		return nil, ErrPreparationProtocol
+	}
+	data, err := json.Marshal(r)
+	if err != nil {
+		return nil, ErrPreparationProtocol
+	}
+	if _, err := DecodePreparationRequest(data); err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+func ParsePreparationResponse(exitCode int, data []byte, request PreparationRequest, outcome string) (PreparationResponse, error) {
+	keys := append(append([]string(nil), preparationRequestKeys...), "outcome", "reservation_key", "record_sequence", "replay", "dispatched")
+	if exitCode != 0 || (outcome != "recorded" && outcome != "validated") || request.Validate() != nil || !exactPreparationObject(data, keys) {
+		return PreparationResponse{}, ErrPreparationProtocol
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var r PreparationResponse
+	if decoder.Decode(&r) != nil || decoder.Decode(new(any)) != io.EOF || r.PreparationRequest != request || r.Outcome != outcome || r.RecordSequence <= 0 || r.Replay == nil || r.Dispatched == nil || *r.Dispatched {
+		return PreparationResponse{}, ErrPreparationProtocol
+	}
+	key, err := hex.DecodeString(r.ReservationKey)
+	if err != nil || len(key) != 32 || hex.EncodeToString(key) != r.ReservationKey {
+		return PreparationResponse{}, ErrPreparationProtocol
+	}
+	if outcome == "validated" && !*r.Replay {
+		return PreparationResponse{}, ErrPreparationProtocol
+	}
+	return r, nil
+}
+func EncodePreparationResponse(r PreparationResponse, request PreparationRequest) ([]byte, error) {
+	data, err := json.Marshal(r)
+	if err != nil {
+		return nil, ErrPreparationProtocol
+	}
+	if _, err := ParsePreparationResponse(0, data, request, r.Outcome); err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+
+// PreparationProvider is an explicitly enabled original-source metadata issuer.
+// Receipt validation is a lookup, not a physical create or release permit.
+type PreparationProvider interface {
+	PreparationEnabled() bool
+	RecordPreparation(context.Context, PreparationRequest) error
+	ValidatePreparation(context.Context, PreparationRequest) error
+}
+
+var ErrPreparationHold = errors.New("original preparation unconfirmed; retain allocation")
+
+func PreparationEnabled(provider Provider) bool {
+	p, ok := provider.(PreparationProvider)
+	return ok && p.PreparationEnabled()
+}
+
+// RunPreparationProvider transmits only bounded nonsecret metadata. Unknown
+// acknowledgement is NOT retried or interpreted as failure-before-commit.
+func RunPreparationProvider(ctx context.Context, binary string, environ []string, request PreparationRequest, outcome string) error {
+	input, err := EncodePreparationRequest(request)
+	if err != nil {
+		return ErrPreparationHold
+	}
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	output := &admissionOutput{}
+	command := exec.CommandContext(ctx, binary)
+	command.WaitDelay = 250 * time.Millisecond
+	command.Env = environ
+	command.Stdin = bytes.NewReader(input)
+	command.Stdout = output
+	command.Stderr = io.Discard
+	if command.Run() != nil || ctx.Err() != nil || output.overflow {
+		return ErrPreparationHold
+	}
+	if _, err := ParsePreparationResponse(0, output.Bytes(), request, outcome); err != nil {
+		return ErrPreparationHold
+	}
+	return nil
+}
+
+// WithOriginalPreparation enables exact JIT source validation only for opted-in
+// receipt issuers. Legacy provider behavior is unchanged.
+type originalPreparationContextKey struct{}
+
+func WithOriginalPreparation(ctx context.Context) context.Context {
+	return context.WithValue(ctx, originalPreparationContextKey{}, true)
+}
+func OriginalPreparationRequired(ctx context.Context) bool {
+	value, _ := ctx.Value(originalPreparationContextKey{}).(bool)
+	return value
+}
+
+// ValidateOriginalJITIdentity binds both trusted API return and decoded runner metadata.
+// Private JIT bytes never enter a receipt, error or log.
+func ValidateOriginalJITIdentity(name string, agent int64, jit map[string]string) error {
+	if agent <= 0 || len(jit) == 0 {
+		return ErrPreparationHold
+	}
+	for key := range jit {
+		if strings.EqualFold(key, ".runner") && key != ".runner" {
+			return ErrPreparationHold
+		}
+	}
+	encoded, ok := jit[".runner"]
+	if !ok || len(encoded) > 128<<10 {
+		return ErrPreparationHold
+	}
+	raw, err := base64.StdEncoding.Strict().DecodeString(encoded)
+	if err != nil || len(raw) > 64<<10 {
+		return ErrPreparationHold
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return ErrPreparationHold
+	}
+	seen := map[string]bool{}
+	var id int64
+	var runnerName string
+	for d.More() {
+		token, err = d.Token()
+		key, ok := token.(string)
+		if err != nil || !ok || seen[key] {
+			return ErrPreparationHold
+		}
+		seen[key] = true
+		var value json.RawMessage
+		if d.Decode(&value) != nil {
+			return ErrPreparationHold
+		}
+		if strings.EqualFold(key, "agentId") {
+			if key != "agentId" || bytes.Equal(bytes.TrimSpace(value), []byte("null")) || json.Unmarshal(value, &id) != nil {
+				return ErrPreparationHold
+			}
+		}
+		if strings.EqualFold(key, "agentName") {
+			if key != "agentName" || json.Unmarshal(value, &runnerName) != nil {
+				return ErrPreparationHold
+			}
+		}
+	}
+	token, err = d.Token()
+	if err != nil || token != json.Delim('}') || d.Decode(new(any)) != io.EOF || !seen["agentId"] || !seen["agentName"] || id != agent || runnerName != name {
+		return ErrPreparationHold
+	}
+	return nil
+}
+
+// DecodeOriginalJITMap rejects duplicate/case-ambiguous secret file keys without
+// including any secret bytes in diagnostics. The caller keeps this map internal.
+func DecodeOriginalJITMap(data []byte) (map[string]string, error) {
+	if len(data) == 0 || len(data) > 1<<20 {
+		return nil, ErrPreparationHold
+	}
+	d := json.NewDecoder(bytes.NewReader(data))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, ErrPreparationHold
+	}
+	result := map[string]string{}
+	for d.More() {
+		token, err = d.Token()
+		key, ok := token.(string)
+		if err != nil || !ok {
+			return nil, ErrPreparationHold
+		}
+		if _, exists := result[key]; exists {
+			return nil, ErrPreparationHold
+		}
+		var value string
+		if d.Decode(&value) != nil {
+			return nil, ErrPreparationHold
+		}
+		result[key] = value
+	}
+	token, err = d.Token()
+	if err != nil || token != json.Delim('}') || d.Decode(new(any)) != io.EOF {
+		return nil, ErrPreparationHold
+	}
+	return result, nil
+}
+
+const CapacityBootstrapMode = "gateway-owned-default-cloudinit/v1"
+
+type CapacityBootstrapProvider interface{ CapacityBootstrapMode() string }
+
+func GatewayBootstrapEnabled(provider Provider) bool {
+	p, ok := provider.(CapacityBootstrapProvider)
+	return ok && PreparationEnabled(provider) && p.CapacityBootstrapMode() == CapacityBootstrapMode
+}
+
+// GatewayBootstrapPool is intentionally narrower than arbitrary Garm templates.
+// The explicit mode never discards a user-selected template or custom options.
+func GatewayBootstrapPool(pool params.Pool) error {
+	if pool.TemplateID != 0 || (len(pool.ExtraSpecs) > 0 && !bytes.Equal(bytes.TrimSpace(pool.ExtraSpecs), []byte("{}"))) || pool.EnableShell || pool.OSType != commonParams.Linux || (pool.OSArch != commonParams.Amd64 && pool.OSArch != commonParams.Arm64) {
+		return ErrPreparationHold
+	}
+	return nil
+}
