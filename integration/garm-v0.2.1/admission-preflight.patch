+//go:build testing
+
+package pool
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+	dbCommon "github.com/cloudbase/garm/database/common"
+	"github.com/cloudbase/garm/locking"
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner/common"
+	"github.com/google/go-github/v84/github"
+	"github.com/stretchr/testify/mock"
+)
+
+func init() {
+	locker, _ := locking.NewLocalLocker(context.Background(), nil)
+	_ = locking.RegisterLocker(locker)
+}
+
+type preparationTestProvider struct {
+	*admissionTestProvider
+	mu            sync.Mutex
+	original      common.PreparationRequest
+	recordEntered chan common.PreparationRequest
+	recordRelease chan struct{}
+	recordErr     error
+	validateErr   error
+	validations   int
+	rejectAt      int
+}
+
+func (p *preparationTestProvider) PreparationEnabled() bool      { return true }
+func (p *preparationTestProvider) CapacityBootstrapMode() string { return common.CapacityBootstrapMode }
+func (p *preparationTestProvider) RecordPreparation(_ context.Context, r common.PreparationRequest) error {
+	p.mu.Lock()
+	p.original = r
+	p.mu.Unlock()
+	if p.recordEntered != nil {
+		p.recordEntered <- r
+		<-p.recordRelease
+	}
+	return p.recordErr
+}
+func (p *preparationTestProvider) ValidatePreparation(_ context.Context, r common.PreparationRequest) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.validations++
+	if p.validateErr != nil || (p.rejectAt > 0 && p.validations >= p.rejectAt) || r != p.original {
+		return common.ErrPreparationHold
+	}
+	return nil
+}
+
+type preparationLostStore struct {
+	dbCommon.Store
+	entered chan params.Instance
+	release chan struct{}
+}
+
+func (p *preparationLostStore) CreateInstance(ctx context.Context, pool string, params params.CreateInstanceParams) (params.Instance, error) {
+	row, err := p.Store.CreateInstance(ctx, pool, params)
+	if err != nil {
+		return row, err
+	}
+	p.entered <- row
+	<-p.release
+	return row, errors.New("disposable-lost-commit-ack")
+}
+
+type preparationJWT struct{}
+
+func (preparationJWT) NewInstanceJWTToken(params.Instance, params.ForgeEntity, uint) (string, error) {
+	return "disposable-not-an-auth-token", nil
+}
+func (preparationJWT) NewAgentJWTToken(params.Instance, params.ForgeEntity) (string, error) {
+	return "disposable-not-an-auth-token", nil
+}
+func (s *PoolStressTestSuite) preparationSetup() (*preparationTestProvider, *atomic.Int32) {
+	gate := &preparationTestProvider{admissionTestProvider: &admissionTestProvider{Provider: s.providerMock}}
+	s.mgr.providers[s.pool.ProviderName] = gate
+	_, err := s.store.UpdateEntityPool(s.adminCtx, s.entity, s.pool.ID, params.UpdatePoolParams{ExtraSpecs: json.RawMessage(`{}`)})
+	s.Require().NoError(err)
+	s.mgr.instanceTokenGetter = preparationJWT{}
+	s.providerMock.On("DisableJITConfig").Return(false).Once()
+	s.ghcliMock.On("GetEntityJITConfig", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(func(_ context.Context, name string, _ params.Pool, _ []string) (map[string]string, *github.Runner, error) {
+		data, _ := json.Marshal(map[string]any{"agentId": int64(42), "agentName": name})
+		return map[string]string{".runner": base64.StdEncoding.EncodeToString(data)}, &github.Runner{ID: github.Int64(42), Name: github.String(name)}, nil
+	}).Once()
+	calls := &atomic.Int32{}
+	s.providerMock.On("CreateInstance", mock.Anything, mock.Anything, mock.Anything).Run(func(mock.Arguments) { calls.Add(1) }).Return(commonParams.ProviderInstance{ProviderID: "disposable-provider", Status: commonParams.InstanceRunning}, nil).Maybe()
+	return gate, calls
+}
+func (s *PoolStressTestSuite) waitPreparationRunning(name string) {
+	until := time.Now().Add(3 * time.Second)
+	for {
+		row, err := s.store.GetInstance(s.adminCtx, name)
