--- /dev/null
+++ b/runner/pool/preparation.go
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+package pool
+
+import (
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner/common"
+)
+
+func (r *basePoolManager) preparationRequest(pool params.Pool, instance params.Instance) (common.PreparationRequest, error) {
+	if !common.GatewayBootstrapEnabled(r.providers[pool.ProviderName]) || common.GatewayBootstrapPool(pool) != nil {
+		return common.PreparationRequest{}, common.ErrPreparationHold
+	}
+	request := common.PreparationRequest{Protocol: common.PreparationVersion, Name: instance.Name, PoolID: instance.PoolID, InstanceID: instance.ID, AgentID: instance.AgentID, Generation: instance.Generation, ProviderName: pool.ProviderName, EntityType: string(r.entity.EntityType), EntityID: r.entity.ID, ForgeEndpointName: r.entity.Credentials.Endpoint.Name, JITEnabled: len(instance.JitConfiguration) > 0}
+	entity, err := pool.GetEntity()
+	if err != nil || entity.ID != r.entity.ID || entity.EntityType != r.entity.EntityType || pool.Endpoint.Name != request.ForgeEndpointName || instance.ProviderName != pool.ProviderName || instance.Generation != pool.Generation || instance.ScaleSetID != 0 || instance.ProviderID != "" || instance.RunnerStatus != params.RunnerPending || instance.Job != nil || (instance.Status != commonParams.InstancePendingCreate && instance.Status != commonParams.InstanceCreating) || request.Validate() != nil {
+		return common.PreparationRequest{}, common.ErrPreparationHold
+	}
+	if request.JITEnabled && common.ValidateOriginalJITIdentity(instance.Name, instance.AgentID, instance.JitConfiguration) != nil {
+		return common.PreparationRequest{}, common.ErrPreparationHold
+	}
+	return request, nil
+}
+func (r *basePoolManager) validatePreparation(instance params.Instance, pool params.Pool, provider common.Provider) error {
+	if !common.PreparationEnabled(provider) {
+		return nil
+	}
+	request, err := r.preparationRequest(pool, instance)
+	if err != nil {
+		return common.ErrPreparationHold
+	}
+	if provider.(common.PreparationProvider).ValidatePreparation(r.ctx, request) != nil {
+		return common.ErrPreparationHold
+	}
+	return nil
+}
