+			if stage == "row" {
+				store.createError = errors.New("row failed")
+			}
+			w := &Worker{ctx: context.Background(), provider: gate, store: store, scaleSet: params.ScaleSet{Name: "cancel-test", RepoID: entity.ID, Enabled: true, MinIdleRunners: 1, MaxRunners: 1}, runners: map[string]params.Instance{}}
+			w.handleScaleUp()
