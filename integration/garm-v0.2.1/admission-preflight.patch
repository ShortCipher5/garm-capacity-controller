+	"github.com/google/go-github/v84/github"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+)
+
+type admissionTestProvider struct {
+	common.Provider     // nil: any lifecycle call panics, rather than silently passing.
+	result              error
+	requests            []common.AdmissionRequest
+	cancelled           []common.AdmissionRequest
+	cancelResult        error
+	cancelContextErrors []error
+	cancelDeadlines     []time.Duration
+	afterAdmit          func()
+}
+
+func (p *admissionTestProvider) AdmitInstance(_ context.Context, request common.AdmissionRequest) error {
+	p.requests = append(p.requests, request)
+	if p.result == nil && p.afterAdmit != nil {
+		p.afterAdmit()
+	}
+	return p.result
+}
+
+func (p *admissionTestProvider) CancelAdmission(ctx context.Context, request common.AdmissionRequest) error {
+	p.cancelled = append(p.cancelled, request)
+	p.cancelContextErrors = append(p.cancelContextErrors, ctx.Err())
+	if deadline, ok := ctx.Deadline(); ok {
+		p.cancelDeadlines = append(p.cancelDeadlines, time.Until(deadline))
+	}
+	return p.cancelResult
+}
+
+type admissionStopStore struct {
+	dbCommon.Store
+	calls int
+}
+
+func (s *admissionStopStore) ControllerInfo() (params.ControllerInfo, error) {
+	s.calls++
+	return params.ControllerInfo{}, errors.New("test boundary after admission")
+}
+
+func TestScaleUpAdmissionBeforeAnyAllocation(t *testing.T) {
+	gate := &admissionTestProvider{result: common.NewAdmissionDeferred(5 * time.Second)}
+	store := &admissionStopStore{}
+	w := &Worker{ctx: context.Background(), provider: gate, store: store,
+		scaleSet: params.ScaleSet{Name: "test-scale", RepoID: "test-repo", Enabled: true, MinIdleRunners: 2, MaxRunners: 2},
+		runners:  map[string]params.Instance{}}
+	w.handleScaleUp()
+	require.Len(t, gate.requests, 1) // stop this batch, not one denial per desired runner
+	require.Equal(t, "test-scale-test-repo", gate.requests[0].PoolID)
+	require.NotEmpty(t, gate.requests[0].Name)
+	require.Zero(t, store.calls) // no DB call, JIT lookup, create or cleanup can run
+	require.Empty(t, w.runners)
+
+	gate.result = errors.New("transport unavailable")
+	w.handleScaleUp()
+	require.Len(t, gate.requests, 2)
+	require.Zero(t, store.calls)
+	require.Empty(t, w.runners)
+
+	// A later target-driven iteration retries with a fresh name. The sentinel
+	// stops at the next setup boundary; this is not an end-to-end JIT success test.
+	gate.result = nil
+	w.handleScaleUp()
+	require.Len(t, gate.requests, 3)
+	require.Equal(t, 1, store.calls)
+	require.NotEqual(t, gate.requests[0].Name, gate.requests[2].Name)
+	require.Empty(t, w.runners)
+}
+
+type admissionRecordingStore struct {
+	dbCommon.Store
+	rows            []params.Instance
+	createError     error
+	controllerError error
+}
+
+func (s *admissionRecordingStore) ControllerInfo() (params.ControllerInfo, error) {
+	return params.ControllerInfo{}, s.controllerError
+}
+func (s *admissionRecordingStore) CreateScaleSetInstance(_ context.Context, _ uint, p params.CreateInstanceParams) (params.Instance, error) {
+	if s.createError != nil {
+		return params.Instance{}, s.createError
+	}
+	row := params.Instance{ID: p.Name, Name: p.Name, AgentID: p.AgentID, CreateAttempt: p.CreateAttempt}
+	s.rows = append(s.rows, row)
+	return row, nil
+}
+
+func TestScaleUpDeniedThenFreshJITAndOneRow(t *testing.T) {
+	var jitCalls atomic.Int64
+	var server *httptest.Server
+	// All HTTP terminates in this disposable loopback fixture, not GitHub.
