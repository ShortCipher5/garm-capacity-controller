new file mode 100644
index 0000000..e39c7f9
--- /dev/null
+++ b/runner/common/admission_cancellation.go
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: Apache-2.0
+package common
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"time"
+)
+
+// AdmissionCancellationProvider is optional best-effort cleanup after a successful
+// reservation's pre-create setup failed. Only the gateway ledger proves never-
+// dispatched status; a refusal/race/unknown create remains charged. NOT DeleteInstance.
+type AdmissionCancellationProvider interface {
+	CancelAdmission(context.Context, AdmissionRequest) error
+}
+
+type admissionCancellationResponse struct {
+	Protocol       string `json:"protocol"`
+	Outcome        string `json:"outcome"`
+	Name           string `json:"name"`
+	PoolID         string `json:"pool_id"`
+	Dispatched     *bool  `json:"dispatched"`
+	ReservationKey string `json:"reservation_key"`
+	Replay         *bool  `json:"replay"`
+}
+
+func parseAdmissionCancellationResponse(exitCode int, output []byte, request AdmissionRequest) error {
+	if exitCode != 0 || request.validate() != nil || len(output) > admissionMaximumResponseBytes {
+		return errAdmissionProtocol
+	}
+	allowed := map[string]bool{"protocol": true, "outcome": true, "name": true, "pool_id": true, "dispatched": true, "reservation_key": true, "replay": true}
+	decoder := json.NewDecoder(bytes.NewReader(output))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return errAdmissionProtocol
+	}
+	seen := map[string]bool{}
+	for decoder.More() {
+		token, err := decoder.Token()
+		key, ok := token.(string)
+		if err != nil || !ok || !allowed[key] || seen[key] {
+			return errAdmissionProtocol
+		}
+		seen[key] = true
+		var raw json.RawMessage
+		if decoder.Decode(&raw) != nil || bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+			return errAdmissionProtocol
+		}
+	}
+	if _, err := decoder.Token(); err != nil || len(seen) != 7 || decoder.Decode(new(any)) != io.EOF {
+		return errAdmissionProtocol
+	}
+	decoder = json.NewDecoder(bytes.NewReader(output))
+	decoder.DisallowUnknownFields()
+	var response admissionCancellationResponse
+	if decoder.Decode(&response) != nil || decoder.Decode(new(any)) != io.EOF || response.Protocol != AdmissionProtocolVersion || response.Outcome != "cancelled" || response.Name != request.Name || response.PoolID != request.PoolID || response.Dispatched == nil || *response.Dispatched || response.Replay == nil || !validAdmissionIdentity(response.ReservationKey) {
+		return errAdmissionProtocol
+	}
+	return nil
+}
+
+// RunAdmissionCancellationProvider carries only protocol/name/pool identity.
+// Child execution is bounded to ten seconds or the earlier caller deadline, with
+// a maximum250ms inherited-pipe drain tail. Stdout/stderr never enter error text.
+// Failure is NOT cancellation proof and cannot release capacity locally.
+func RunAdmissionCancellationProvider(ctx context.Context, binary string, environ []string, request AdmissionRequest) error {
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	if request.validate() != nil {
+		return errAdmissionProtocol
+	}
+	input, err := json.Marshal(struct {
+		Protocol string `json:"protocol"`
+		Name     string `json:"name"`
+		PoolID   string `json:"pool_id"`
+	}{AdmissionProtocolVersion, request.Name, request.PoolID})
+	if err != nil {
+		return errAdmissionProtocol
+	}
+	output := &admissionOutput{}
+	command := exec.CommandContext(ctx, binary)
+	// Bound inherited pipes even if a descendant outlives the direct child.
+	command.WaitDelay = 250 * time.Millisecond
+	command.Env = environ
+	command.Stdin = bytes.NewReader(input)
+	command.Stdout = output
+	command.Stderr = io.Discard
+	runErr := command.Run()
+	if ctx.Err() != nil {
+		return fmt.Errorf("admission reservation cancellation canceled: %w", ctx.Err())
+	}
+	if output.overflow {
+		return errAdmissionProtocol
+	}
+	exitCode := 0
+	if runErr != nil {
+		var exited *exec.ExitError
+		if !errors.As(runErr, &exited) {
+			return errors.New("admission cancellation executable unavailable")
+		}
+		exitCode = exited.ExitCode()
+	}
+	return parseAdmissionCancellationResponse(exitCode, output.Bytes(), request)
+}
