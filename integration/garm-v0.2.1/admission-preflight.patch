+					}
+					_ = json.NewEncoder(rw).Encode(params.RunnerScaleSetJitRunnerConfig{Runner: &params.RunnerReference{ID: 42}, EncodedJITConfig: encoded})
+					return
+				}
+				if r.Method == http.MethodDelete {
+					removeCalls.Add(1)
+					rw.WriteHeader(http.StatusNoContent)
+					return
+				}
+				http.Error(rw, "unexpected endpoint", http.StatusNotFound)
+			}))
+			defer server.Close()
+			entity := params.ForgeEntity{ID: "cancel-scale-" + stage, EntityType: params.ForgeEntityTypeRepository}
+			if stage != "controller" && stage != "client" {
+				gh := commonMocks.NewGithubClient(t)
+				base, err := url.Parse(server.URL)
+				require.NoError(t, err)
+				gh.On("GetEntity").Return(entity)
+				gh.On("GithubBaseURL").Return(base)
+				gh.On("CreateEntityRegistrationToken", mock.Anything).Return(&github.RegistrationToken{Token: github.String("fixture"), ExpiresAt: &github.Timestamp{Time: time.Now().Add(time.Hour)}}, nil, nil).Once()
+				cache.SetGithubClient(entity.ID, gh)
+				defer cache.DeleteGithubClient(entity.ID)
+			}
+			gate := &admissionTestProvider{cancelResult: errors.New("secret-cancellation-refused")}
+			store := &admissionRecordingStore{}
+			if stage == "controller" {
