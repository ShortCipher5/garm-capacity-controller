+			} else {
+				require.Positive(t, jitCalls.Load())
+			}
+			if stage == "row" {
+				require.Equal(t, int64(1), removeCalls.Load())
+			} else {
+				require.Zero(t, removeCalls.Load())
+			}
+		})
+	}
+}
+func TestScaleUpCancellationIndependentlyBoundedAndNeverRunsOnDeferOrSuccess(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	gate := &admissionTestProvider{afterAdmit: cancel}
+	store := &admissionStopStore{}
+	w := &Worker{ctx: ctx, provider: gate, store: store, scaleSet: params.ScaleSet{Name: "context", RepoID: "context", Enabled: true, MinIdleRunners: 1, MaxRunners: 1}, runners: map[string]params.Instance{}}
+	w.handleScaleUp()
+	require.ErrorIs(t, ctx.Err(), context.Canceled)
+	require.Equal(t, gate.requests, gate.cancelled)
+	require.Equal(t, []error{nil}, gate.cancelContextErrors)
+	require.Len(t, gate.cancelDeadlines, 1)
+	require.Positive(t, gate.cancelDeadlines[0])
+	require.LessOrEqual(t, gate.cancelDeadlines[0], 10*time.Second)
+	gate.result = common.NewAdmissionDeferred(5 * time.Second)
+	w.handleScaleUp()
+	require.Len(t, gate.cancelled, 1)
+}
