+	s.Equal(gate.requests, gate.cancelled)
+	s.Equal([]error{nil}, gate.cancelContextErrors)
+	s.Require().Len(gate.cancelDeadlines, 1)
+	s.Greater(gate.cancelDeadlines[0], time.Duration(0))
+	s.LessOrEqual(gate.cancelDeadlines[0], 10*time.Second)
+	rows, err := s.store.ListPoolInstances(s.adminCtx, s.pool.ID, false)
+	s.Require().NoError(err)
+	s.Empty(rows)
+}
+func (s *PoolStressTestSuite) TestAdmissionRowFailureCancelsButSuccessAndDeferDoNot() {
+	failure := errors.New("original row failure")
+	gate := &admissionTestProvider{Provider: s.providerMock}
+	s.mgr.providers[s.pool.ProviderName] = gate
+	s.mgr.store = &admissionCreateFailureStore{Store: s.store, failure: failure}
+	s.providerMock.On("DisableJITConfig").Return(false).Once()
+	s.ghcliMock.On("GetEntityJITConfig", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(map[string]string{"test": "jit"}, &github.Runner{ID: github.Int64(42)}, nil).Once()
+	s.ghcliMock.On("RemoveEntityRunner", mock.Anything, int64(42)).Return(nil).Once()
+	s.ErrorIs(s.mgr.AddRunner(s.adminCtx, s.pool.ID, nil), failure)
+	s.Equal(gate.requests, gate.cancelled)
+	s.Len(gate.cancelled, 1)
+	s.mgr.store = s.store
+	s.providerMock.On("DisableJITConfig").Return(false).Once()
+	s.ghcliMock.On("GetEntityJITConfig", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(map[string]string{"test": "jit2"}, &github.Runner{ID: github.Int64(43)}, nil).Once()
+	s.Require().NoError(s.mgr.AddRunner(s.adminCtx, s.pool.ID, nil))
+	s.Len(gate.requests, 2)
+	s.Len(gate.cancelled, 1)
+	gate.result = common.NewAdmissionDeferred(5 * time.Second)
+	s.True(common.IsAdmissionDeferred(s.mgr.AddRunner(s.adminCtx, s.pool.ID, nil)))
+	s.Len(gate.cancelled, 1)
+}
