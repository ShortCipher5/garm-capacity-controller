+++ b/runner/common/admission_cancellation_test.go
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: Apache-2.0
+package common
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+)
+
+func cancellationFields() map[string]any {
+	return map[string]any{"protocol": AdmissionProtocolVersion, "outcome": "cancelled", "name": "runner-1", "pool_id": "pool-1", "dispatched": false, "reservation_key": "reservation-1", "replay": false}
+}
+func runCancellationStub(mode string) {
+	if mode == "pipe-child" {
+		time.Sleep(3 * time.Second)
+		os.Exit(0)
+	}
+	input, _ := io.ReadAll(os.Stdin)
+	if mode == "secret" {
+		fmt.Printf("stdout:%s", input)
+		fmt.Fprint(os.Stderr, "secret-must-not-echo")
+		os.Exit(1)
+	}
+	var request map[string]any
+	if json.Unmarshal(input, &request) != nil || len(request) != 3 || request["protocol"] != AdmissionProtocolVersion || os.Getenv("GARM_COMMAND") != "CancelAdmission" {
+		os.Exit(9)
+	}
+	if mode == "wait" {
+		time.Sleep(time.Minute)
+		os.Exit(1)
+	}
+	if mode == "inherited-pipe" {
+		child := exec.Command(os.Args[0])
+		child.Env = []string{"GCC_CANCELLATION_STUB=pipe-child"}
+		child.Stdout = os.Stdout
+		child.Stderr = os.Stderr
+		if child.Start() != nil {
+			os.Exit(9)
+		}
+		time.Sleep(time.Minute)
+		os.Exit(1)
+	}
+	if mode == "oversize" {
+		fmt.Print(strings.Repeat("x", admissionMaximumResponseBytes+1))
+		os.Exit(0)
+	}
+	if mode == "malformed" {
+		fmt.Print("secret-must-not-echo")
+		os.Exit(0)
+	}
+	response := cancellationFields()
+	response["name"] = request["name"]
+	response["pool_id"] = request["pool_id"]
+	exit := 0
+	switch mode {
+	case "replay":
+		response["replay"] = true
+	case "wrong-exit":
+		exit = 75
+	case "dispatched":
+		response["dispatched"] = true
+	case "mismatch":
+		response["pool_id"] = "someone-else"
+	case "stderr":
+		fmt.Fprint(os.Stderr, "secret-must-not-echo")
+	}
+	_ = json.NewEncoder(os.Stdout).Encode(response)
+	os.Exit(exit)
+}
+
+func TestCancellationProtocolRequiresExactlySevenTypedNonNullKeys(t *testing.T) {
+	request := AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	for _, replay := range []bool{false, true} {
+		fields := cancellationFields()
+		fields["replay"] = replay
+		data, _ := json.Marshal(fields)
+		if err := parseAdmissionCancellationResponse(0, data, request); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for key := range cancellationFields() {
+		for _, mode := range []string{"missing", "null", "wrong-type", "duplicate", "case-fold"} {
+			fields := cancellationFields()
+			switch mode {
+			case "missing":
+				delete(fields, key)
+			case "null":
+				fields[key] = nil
+			case "wrong-type":
+				fields[key] = []any{}
+			case "case-fold":
+				fields[strings.ToUpper(key)] = fields[key]
+				delete(fields, key)
+			}
+			data, _ := json.Marshal(fields)
+			if mode == "duplicate" {
+				data = []byte(`{"` + key + `":null,` + string(data[1:]))
+			}
+			if err := parseAdmissionCancellationResponse(0, data, request); err == nil {
+				t.Fatalf("accepted %s %s", key, mode)
+			}
+		}
+	}
+	for _, mutate := range []func(map[string]any){func(f map[string]any) { f["extra"] = false }, func(f map[string]any) { f["dispatched"] = true }, func(f map[string]any) { f["name"] = "other" }, func(f map[string]any) { f["pool_id"] = "other" }, func(f map[string]any) { f["outcome"] = "reserved" }, func(f map[string]any) { f["reservation_key"] = "" }} {
+		fields := cancellationFields()
+		mutate(fields)
+		data, _ := json.Marshal(fields)
+		if err := parseAdmissionCancellationResponse(0, data, request); err == nil {
+			t.Fatal("invalid response accepted")
+		}
+	}
+	data, _ := json.Marshal(cancellationFields())
+	for _, exit := range []int{1, 75, -1} {
+		if err := parseAdmissionCancellationResponse(exit, data, request); err == nil {
+			t.Fatal("nonzero exit accepted")
+		}
+	}
+	for _, data := range [][]byte{append(data, []byte(` {}`)...), []byte(`null`), []byte(strings.Repeat("x", 4097))} {
+		if err := parseAdmissionCancellationResponse(0, data, request); err == nil {
+			t.Fatal("invalid framing accepted")
+		}
+	}
+}
+
+func TestCancellationExecutableBoundaryAndRedaction(t *testing.T) {
+	request := AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	for _, mode := range []string{"success", "replay", "stderr", "wrong-exit", "dispatched", "mismatch", "oversize", "malformed", "secret"} {
+		err := RunAdmissionCancellationProvider(context.Background(), os.Args[0], []string{"GARM_COMMAND=CancelAdmission", "GCC_CANCELLATION_STUB=" + mode}, request)
+		good := mode == "success" || mode == "replay" || mode == "stderr"
+		if (err == nil) != good || IsAdmissionDeferred(err) {
+			t.Fatalf("unsafe %s: %v", mode, err)
+		}
+		if err != nil && strings.Contains(err.Error(), "secret-must-not-echo") {
+			t.Fatal("child output disclosed")
+		}
+	}
+	if err := RunAdmissionCancellationProvider(context.Background(), "/secret-path-must-not-echo", nil, request); err == nil || strings.Contains(err.Error(), "secret-path") {
+		t.Fatal("executable error disclosed path")
+	}
+}
+
+func TestCancellationDeadlineAndInheritedPipesStayBounded(t *testing.T) {
+	request := AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	for _, admit := range []bool{false, true} {
+		ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+		start := time.Now()
+		run := RunAdmissionCancellationProvider
+		if admit {
+			run = RunAdmissionProvider
+		}
+		err := run(ctx, os.Args[0], []string{"GARM_COMMAND=CancelAdmission", "GCC_CANCELLATION_STUB=inherited-pipe"}, request)
+		cancel()
+		if !errors.Is(err, context.DeadlineExceeded) || IsAdmissionDeferred(err) || time.Since(start) > 2*time.Second {
+			t.Fatalf("inherited pipes escaped deadline: %v %s", err, time.Since(start))
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	if err := RunAdmissionCancellationProvider(ctx, os.Args[0], []string{"GARM_COMMAND=CancelAdmission", "GCC_CANCELLATION_STUB=wait"}, request); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal("earlier deadline ignored")
+	}
+}
+
+func TestCancellationDefaultTenSecondDeadline(t *testing.T) {
+	start := time.Now()
+	err := RunAdmissionCancellationProvider(context.Background(), os.Args[0], []string{"GARM_COMMAND=CancelAdmission", "GCC_CANCELLATION_STUB=wait"}, AdmissionRequest{Name: "runner-1", PoolID: "pool-1"})
+	if !errors.Is(err, context.DeadlineExceeded) || time.Since(start) > 15*time.Second {
+		t.Fatalf("unbounded cancellation child: %v %s", err, time.Since(start))
+	}
+}
diff --git a/runner/common/admission_test.go b/runner/common/admission_test.go
