+			require.Equal(t, gate.requests, gate.cancelled)
+			require.Equal(t, []error{nil}, gate.cancelContextErrors)
+			require.Len(t, gate.cancelDeadlines, 1)
+			require.Positive(t, gate.cancelDeadlines[0])
+			require.LessOrEqual(t, gate.cancelDeadlines[0], 10*time.Second)
