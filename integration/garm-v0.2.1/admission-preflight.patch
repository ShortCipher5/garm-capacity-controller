+// SPDX-License-Identifier: Apache-2.0
+package v011
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	garmErrors "github.com/cloudbase/garm-provider-common/errors"
+	"io"
