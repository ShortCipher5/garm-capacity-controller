@@ -0,0 +1,138 @@
+package scaleset
+
+import (
+	"context"
+	"errors"
+ "encoding/base64"
+ "encoding/json"
+ "fmt"
+ "net/http"
+ "net/http/httptest"
+ "net/url"
+ "strings"
+ "sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+ "github.com/stretchr/testify/mock"
+ "github.com/google/go-github/v84/github"
+ "github.com/cloudbase/garm/cache"
+ commonMocks "github.com/cloudbase/garm/runner/common/mocks"
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner/common"
+	dbCommon "github.com/cloudbase/garm/database/common"
+)
+
+type admissionTestProvider struct {
+	common.Provider // nil: any lifecycle call panics, rather than silently passing.
+	result error
+	requests []common.AdmissionRequest
+}
+func (p *admissionTestProvider) AdmitInstance(_ context.Context, request common.AdmissionRequest) error {
+	p.requests = append(p.requests, request)
+	return p.result
+}
+
+type admissionStopStore struct {
+	dbCommon.Store
+	calls int
+}
+func (s *admissionStopStore) ControllerInfo() (params.ControllerInfo, error) {
+	s.calls++
+	return params.ControllerInfo{}, errors.New("test boundary after admission")
+}
+
+func TestScaleUpAdmissionBeforeAnyAllocation(t *testing.T) {
+	gate := &admissionTestProvider{result:common.NewAdmissionDeferred(5*time.Second)}
+	store := &admissionStopStore{}
+	w := &Worker{ctx:context.Background(), provider:gate, store:store,
+		scaleSet:params.ScaleSet{Name:"test-scale", RepoID:"test-repo", Enabled:true, MinIdleRunners:2, MaxRunners:2},
+		runners:map[string]params.Instance{}}
+	w.handleScaleUp()
+	require.Len(t, gate.requests, 1) // stop this batch, not one denial per desired runner
+	require.Equal(t, "test-scale-test-repo", gate.requests[0].PoolID)
+	require.NotEmpty(t, gate.requests[0].Name)
+	require.Zero(t, store.calls) // no DB call, JIT lookup, create or cleanup can run
+	require.Empty(t, w.runners)
+
+	gate.result = errors.New("transport unavailable")
+	w.handleScaleUp()
+	require.Len(t, gate.requests, 2)
+	require.Zero(t, store.calls)
+	require.Empty(t, w.runners)
+
+	// A later target-driven iteration retries with a fresh name. The sentinel
+	// stops at the next setup boundary; this is not an end-to-end JIT success test.
+	gate.result = nil
+	w.handleScaleUp()
+	require.Len(t, gate.requests, 3)
+	require.Equal(t, 1, store.calls)
+	require.NotEqual(t, gate.requests[0].Name, gate.requests[2].Name)
+	require.Empty(t, w.runners)
+}
+
+
+type admissionRecordingStore struct {
+ dbCommon.Store
+ rows []params.Instance
+}
+func (s *admissionRecordingStore) ControllerInfo() (params.ControllerInfo, error) {
+ return params.ControllerInfo{}, nil
+}
+func (s *admissionRecordingStore) CreateScaleSetInstance(_ context.Context, _ uint, p params.CreateInstanceParams) (params.Instance, error) {
+ row := params.Instance{ID:p.Name, Name:p.Name, AgentID:p.AgentID, CreateAttempt:p.CreateAttempt}
+ s.rows = append(s.rows, row)
+ return row, nil
+}
+
+func TestScaleUpDeniedThenFreshJITAndOneRow(t *testing.T) {
+ var jitCalls atomic.Int64
+ var server *httptest.Server
+ // All HTTP terminates in this disposable loopback fixture, not GitHub.
+ server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+  if r.URL.Path == "/actions/runner-registration" {
+   payload := base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"exp":%d}`, time.Now().Add(time.Hour).Unix())))
+   token := "eyJhbGciOiJIUzI1NiJ9."+payload+".c2ln"
+   _ = json.NewEncoder(w).Encode(params.ActionsServiceAdminInfoResponse{URL:server.URL, Token:token})
+   return
+  }
+  if strings.HasSuffix(r.URL.Path, "/generatejitconfig") {
+   jitCalls.Add(1)
+   _ = json.NewEncoder(w).Encode(params.RunnerScaleSetJitRunnerConfig{
+    Runner:&params.RunnerReference{ID:42},
+    EncodedJITConfig:base64.StdEncoding.EncodeToString([]byte(`{"test":"fresh"}`)),
+   })
+   return
+  }
+  http.Error(w, "unexpected endpoint", http.StatusNotFound)
+ }))
+ defer server.Close()
+ entity := params.ForgeEntity{ID:"prejit-scale-test", EntityType:params.ForgeEntityTypeRepository}
+ gh := commonMocks.NewGithubClient(t)
+ base, err := url.Parse(server.URL)
+ require.NoError(t, err)
+ gh.On("GetEntity").Return(entity)
+ gh.On("GithubBaseURL").Return(base)
+ gh.On("CreateEntityRegistrationToken", mock.Anything).Return(
+  &github.RegistrationToken{Token:github.String("fixture"), ExpiresAt:&github.Timestamp{Time:time.Now().Add(time.Hour)}}, nil, nil).Once()
+ cache.SetGithubClient(entity.ID, gh)
+ defer cache.DeleteGithubClient(entity.ID)
+ gate := &admissionTestProvider{result:common.NewAdmissionDeferred(5*time.Second)}
+ store := &admissionRecordingStore{}
+ w := &Worker{ctx:context.Background(), provider:gate, store:store,
+  scaleSet:params.ScaleSet{Name:"test", RepoID:entity.ID, Enabled:true, MinIdleRunners:1, MaxRunners:1},
+  runners:map[string]params.Instance{}}
+ w.handleScaleUp()
+ require.Zero(t, jitCalls.Load())
+ require.Empty(t, gh.Calls)
+ require.Empty(t, store.rows)
+ gate.result = nil
+ w.handleScaleUp()
+ require.Equal(t, int64(1), jitCalls.Load())
+ require.Len(t, store.rows, 1)
+ require.Len(t, w.runners, 1)
+ require.Equal(t, gate.requests[1].Name, store.rows[0].Name)
+ require.NotEqual(t, gate.requests[0].Name, store.rows[0].Name)
+ require.Equal(t, 1, store.rows[0].CreateAttempt)
+}
