+package sql
+
+import (
+	"encoding/json"
+	"github.com/cloudbase/garm/params"
+	"github.com/google/uuid"
+)
+
+func (s *InstancesTestSuite) TestPreparationPrivatePreallocatedRowUUID() {
+	entity, err := s.Fixtures.Org.GetEntity()
+	s.Require().NoError(err)
+	pool, err := s.Store.CreateEntityPool(s.adminCtx, entity, params.CreatePoolParams{ProviderName: "preparation-fixture", MaxRunners: 10, Image: "pinned-image", Flavor: "small", OSType: "linux", OSArch: "amd64", Tags: []string{"linux"}})
+	s.Require().NoError(err)
+	id := uuid.NewString()
+	row, err := s.Store.CreateInstance(s.adminCtx, pool.ID, params.CreateInstanceParams{Name: "preallocated", AdmissionInstanceID: id, AgentID: 42})
+	s.Require().NoError(err)
+	s.Equal(id, row.ID)
+	_, err = s.Store.CreateInstance(s.adminCtx, pool.ID, params.CreateInstanceParams{Name: "duplicate-id", AdmissionInstanceID: id})
+	s.Require().Error(err)
+	for _, bad := range []string{"bad", "00000000-0000-0000-0000-000000000000", "AAAAAAAA-AAAA-4AAA-8AAA-AAAAAAAAAAAA"} {
+		_, err = s.Store.CreateInstance(s.adminCtx, pool.ID, params.CreateInstanceParams{Name: "bad-id", AdmissionInstanceID: bad})
+		s.Require().Error(err)
+	}
+	var input params.CreateInstanceParams
+	s.Require().NoError(json.Unmarshal([]byte(`{"AdmissionInstanceID":"`+uuid.NewString()+`","admission_instance_id":"`+uuid.NewString()+`"}`), &input))
+	s.Empty(input.AdmissionInstanceID)
+}
