+++ b/runner/providers/v0.1.1/admission_test.go
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: Apache-2.0
+package v011
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	garmErrors "github.com/cloudbase/garm-provider-common/errors"
+	"io"
+	"os"
+	"strings"
+	"testing"
+
+	commonParams "github.com/cloudbase/garm-provider-common/params"
+	"github.com/cloudbase/garm/config"
+	"github.com/cloudbase/garm/runner/common"
+)
+
+func TestMain(m *testing.M) {
+	if mode := os.Getenv("GCC_EXTERNAL_CANCELLATION_STUB"); mode != "" {
+		runExternalCancellationStub(mode)
+		return
+	}
+	if mode := os.Getenv("GCC_EXTERNAL_ADMISSION_STUB"); mode != "" {
+		input, _ := io.ReadAll(os.Stdin)
+		if mode == "list" {
+			_ = json.NewEncoder(os.Stdout).Encode([]commonParams.ProviderInstance{{Name: "runner", ProviderID: "runner", Status: commonParams.InstanceRunning}})
+			os.Exit(0)
+		}
+		if mode == "not-found" {
+			fmt.Fprint(os.Stderr, "must-not-echo")
+			os.Exit(30)
+		}
+
+		if mode == "echo-failure" {
+			fmt.Printf("%s", input)
+			fmt.Fprintf(os.Stderr, "%s", input)
+			os.Exit(1)
+		}
+		if mode == "invalid-status" || mode == "provider-fault" {
+			var bootstrap commonParams.BootstrapInstance
+			_ = json.Unmarshal(input, &bootstrap)
+			result := commonParams.ProviderInstance{Name: bootstrap.Name, ProviderID: "test-instance", Status: commonParams.InstanceStatus("secret-must-not-echo")}
+			if mode == "provider-fault" {
+				result.Status = commonParams.InstanceError
+				result.ProviderFault = []byte("secret-must-not-echo")
+			}
+			_ = json.NewEncoder(os.Stdout).Encode(result)
+			os.Exit(0)
+		}
+		var fields map[string]any
+		_ = json.Unmarshal(input, &fields)
+		if len(fields) != 3 || fields["protocol"] != common.AdmissionProtocolVersion || os.Getenv("GARM_COMMAND") != "AdmitInstance" || os.Getenv("GARM_CONTROLLER_ID") != "test-controller" {
+			os.Exit(9)
+		}
+		_ = json.NewEncoder(os.Stdout).Encode(map[string]any{"protocol": common.AdmissionProtocolVersion, "outcome": "deferred", "name": fields["name"], "pool_id": fields["pool_id"], "dispatched": false, "retry_after_seconds": 5})
+		os.Exit(75)
+	}
+	os.Exit(m.Run())
+}
+
+func TestOptionalAdmissionIsExplicitAndCredentialFree(t *testing.T) {
+	cfg := &config.Provider{External: config.External{AdmissionEnabled: false}}
+	provider := &external{cfg: cfg, execPath: "/must-not-run", controllerID: "test-controller"}
+	request := common.AdmissionRequest{Name: "runner-1", PoolID: "pool-1"}
+	if err := provider.AdmitInstance(context.Background(), request); err != nil {
+		t.Fatalf("legacy behavior changed: %v", err)
+	}
+	cfg.External.AdmissionEnabled = true
+	cfg.External.CapacityBootstrapMode = common.CapacityBootstrapMode
+	provider.execPath = os.Args[0]
+	provider.environmentVariables = []string{"GCC_EXTERNAL_ADMISSION_STUB=deferred"}
+	if err := provider.AdmitInstance(context.Background(), request); !common.IsAdmissionDeferred(err) {
+		t.Fatalf("strict preflight not executed: %v", err)
+	}
+}
+
+func TestOptInCreateErrorsDoNotEchoBootstrap(t *testing.T) {
+	cfg := &config.Provider{External: config.External{AdmissionEnabled: true, CapacityBootstrapMode: common.CapacityBootstrapMode}}
+	provider := &external{cfg: cfg, execPath: os.Args[0], environmentVariables: []string{"GCC_EXTERNAL_ADMISSION_STUB=echo-failure"}}
+	secret := "bootstrap-secret-must-not-echo"
+	_, err := provider.CreateInstance(context.Background(), commonParams.BootstrapInstance{Name: "runner", PoolID: "pool", InstanceToken: secret}, common.CreateInstanceParams{})
+	if err == nil || common.IsAdmissionDeferred(err) || strings.Contains(err.Error(), secret) {
+		t.Fatalf("unsafe create result: %v", err)
+	}
+}
+
+func TestOptInCreateValidationAndFaultsAreRedacted(t *testing.T) {
+	for _, mode := range []string{"invalid-status", "provider-fault"} {
+		cfg := &config.Provider{External: config.External{AdmissionEnabled: true, CapacityBootstrapMode: common.CapacityBootstrapMode}}
+		provider := &external{cfg: cfg, execPath: os.Args[0], environmentVariables: []string{"GCC_EXTERNAL_ADMISSION_STUB=" + mode}}
+		result, err := provider.CreateInstance(context.Background(), commonParams.BootstrapInstance{Name: "runner", PoolID: "pool"}, common.CreateInstanceParams{})
+		if err != nil && strings.Contains(err.Error(), "secret-must-not-echo") {
+			t.Fatal("validation error disclosed output")
+		}
+		if strings.Contains(string(result.ProviderFault), "secret-must-not-echo") {
+			t.Fatal("provider fault retained unsafe payload")
+		}
+		if mode == "invalid-status" && err == nil {
+			t.Fatal("invalid provider status accepted")
+		}
+	}
+}
+
+func TestOptInInventorySuccessAndLookupNotFound(t *testing.T) {
+	cfg := &config.Provider{External: config.External{AdmissionEnabled: true, CapacityBootstrapMode: common.CapacityBootstrapMode}}
+	provider := &external{cfg: cfg, execPath: os.Args[0], environmentVariables: []string{"GCC_EXTERNAL_ADMISSION_STUB=list"}}
+	instances, err := provider.ListInstances(context.Background(), "pool", common.ListInstancesParams{})
+	if err != nil || len(instances) != 1 || instances[0].Name != "runner" {
+		t.Fatalf("successful inventory rejected: %+v %v", instances, err)
+	}
+	provider.environmentVariables = []string{"GCC_EXTERNAL_ADMISSION_STUB=not-found"}
+	_, err = provider.GetInstance(context.Background(), "missing", common.GetInstanceParams{})
+	if !errors.Is(err, garmErrors.ErrNotFound) || strings.Contains(err.Error(), "must-not-echo") {
+		t.Fatalf("lookup not-found mapping/redaction: %v", err)
+	}
+	if instances, err = provider.ListInstances(context.Background(), "pool", common.ListInstancesParams{}); err == nil || len(instances) != 0 || strings.Contains(err.Error(), "must-not-echo") {
+		t.Fatalf("failed inventory accepted or leaked: %+v %v", instances, err)
+	}
+}
