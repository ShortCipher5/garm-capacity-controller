diff --git a/runner/common/admission.go b/runner/common/admission.go
new file mode 100644
index 0000000..74f707d
--- /dev/null
+++ b/runner/common/admission.go
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package common
+
+import (
+ "bytes"
+ "context"
+ "encoding/json"
+ "errors"
+ "fmt"
+ "io"
+ "os/exec"
+ "strings"
+ "time"
+ "unicode"
+ "unicode/utf8"
+)
+
+const AdmissionProtocolVersion = "garm-capacity/v1"
+const AdmissionDeferredExitCode = 75
+const admissionMaximumResponseBytes = 4096
+
+var errAdmissionProtocol = errors.New("invalid admission protocol response")
+
+// Request contains no bootstrap, GitHub, controller or Incus credentials.
+// Controller identity and host placement come from trusted provider configuration.
+type AdmissionRequest struct {
+	Name string `json:"name"`
+	PoolID string `json:"pool_id"`
+}
+
+// Response is a preflight receipt only. A later Create must atomically claim
+// the same durable reservation at the gateway; replay is not a dispatch permit.
+type admissionResponse struct {
+	Protocol string `json:"protocol"`
+	Outcome string `json:"outcome"`
+	Name string `json:"name"`
+	PoolID string `json:"pool_id"`
+	Dispatched *bool `json:"dispatched"`
+	ReservationKey string `json:"reservation_key,omitempty"`
+	RetryAfterSeconds int `json:"retry_after_seconds,omitempty"`
+}
+
+func validAdmissionIdentity(value string) bool {
+	if len(value) == 0 || len(value) > 256 || !utf8.ValidString(value) || strings.TrimSpace(value) == "" {
+		return false
+	}
+	for _, r := range value {
+		if unicode.IsControl(r) {
+			return false
+		}
+	}
+	return true
+}
+
+func (r AdmissionRequest) validate() error {
+	if !validAdmissionIdentity(r.Name) || !validAdmissionIdentity(r.PoolID) {
+		return errAdmissionProtocol
+	}
+	return nil
+}
+
+// Parse validates exact identity, explicit no-dispatch assertion and exit-code
+// pairing. Raw child output must not be included in errors or logs.
+func parseAdmissionResponse(exitCode int, output []byte, request AdmissionRequest) (admissionResponse, error) {
+	if request.validate() != nil || len(output) > admissionMaximumResponseBytes || !uniqueAdmissionResponseKeys(output) {
+		return admissionResponse{}, errAdmissionProtocol
+	}
+	decoder := json.NewDecoder(bytes.NewReader(output))
+	decoder.DisallowUnknownFields()
+	var response admissionResponse
+	if decoder.Decode(&response) != nil || decoder.Decode(new(any)) != io.EOF {
+		return admissionResponse{}, errAdmissionProtocol
+	}
+	if response.Protocol != AdmissionProtocolVersion || response.Name != request.Name || response.PoolID != request.PoolID || response.Dispatched == nil || *response.Dispatched {
+		return admissionResponse{}, errAdmissionProtocol
+	}
+	switch response.Outcome {
+	case "reserved":
+		if exitCode != 0 || response.RetryAfterSeconds != 0 || !validAdmissionIdentity(response.ReservationKey) {
+			return admissionResponse{}, errAdmissionProtocol
+		}
+	case "deferred":
+		if exitCode != AdmissionDeferredExitCode || response.ReservationKey != "" || response.RetryAfterSeconds < 5 || response.RetryAfterSeconds > 60 {
+			return admissionResponse{}, errAdmissionProtocol
+		}
+	default:
+		return admissionResponse{}, errAdmissionProtocol
+	}
+	return response, nil
+}
+
+// encoding/json otherwise accepts duplicate and case-folded keys. Those are
+// ambiguous on a safety boundary, so the flat response schema is exact.
+func uniqueAdmissionResponseKeys(data []byte) bool {
+	allowed := map[string]bool{"protocol": true, "outcome": true, "name": true, "pool_id": true, "dispatched": true, "reservation_key": true, "retry_after_seconds": true}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return false
+	}
+	seen := map[string]bool{}
+	for decoder.More() {
+		token, err := decoder.Token()
+		key, ok := token.(string)
+		if err != nil || !ok || seen[key] || !allowed[key] {
+			return false
+		}
+		seen[key] = true
+		var value json.RawMessage
+		if decoder.Decode(&value) != nil {
+			return false
+		}
+	}
+	_, err = decoder.Token()
+	return err == nil && decoder.Decode(new(any)) == io.EOF
+}
+
+// AdmissionProvider is optional and opt-in. It runs before JIT/runner state is
+// allocated. Existing providers without admission retain their legacy behavior.
+// It does not replace the gateway's later atomic dispatch claim.
+type AdmissionProvider interface {
+ AdmitInstance(context.Context, AdmissionRequest) error
+}
+
+type admissionDeferred struct { retryAfter time.Duration }
+func (e *admissionDeferred) Error() string { return "capacity admission deferred before dispatch" }
+
+// NewAdmissionDeferred is only for a trusted, verified never-dispatched result.
+func NewAdmissionDeferred(after time.Duration) error {
+ if after < 5*time.Second || after > 60*time.Second { return errAdmissionProtocol }
+ return &admissionDeferred{retryAfter:after}
+}
+func IsAdmissionDeferred(err error) bool {
+ var deferred *admissionDeferred
+ return errors.As(err,&deferred) && deferred != nil
+}
+func AdmissionRetryAfter(err error) time.Duration {
+ var deferred *admissionDeferred
+ if errors.As(err,&deferred) && deferred != nil { return deferred.retryAfter }
+ return 0
+}
+
+type admissionOutput struct { buffer bytes.Buffer; limit int; overflow bool }
+func (w *admissionOutput) Len() int { return w.buffer.Len() }
+func (w *admissionOutput) Bytes() []byte { return w.buffer.Bytes() }
+func (w *admissionOutput) Write(data []byte) (int,error) {
+ count := len(data)
+ limit := w.limit
+ if limit==0 { limit=admissionMaximumResponseBytes }
+ remaining := limit-w.Len()
+ if len(data)>remaining { w.overflow=true; data=data[:remaining] }
+ _,_ = w.buffer.Write(data)
+ return count,nil
+}
+
+// RunAdmissionProvider uses a separate command carrying no bootstrap payload.
+// Child stdout/stderr are never interpolated into errors or logs. Output is
+// bounded while still drained so an oversized response cannot allocate freely.
+func RunAdmissionProvider(ctx context.Context, binary string, environ []string, request AdmissionRequest) error {
+ if request.validate()!=nil { return errAdmissionProtocol }
+ input,err := json.Marshal(struct {
+  Protocol string `json:"protocol"`
+  Name string `json:"name"`
+  PoolID string `json:"pool_id"`
+ }{AdmissionProtocolVersion,request.Name,request.PoolID})
+ if err!=nil { return errAdmissionProtocol }
+ output := &admissionOutput{}
+ command := exec.CommandContext(ctx,binary)
+ command.Env=environ
+ command.Stdin=bytes.NewReader(input)
+ command.Stdout=output
+ command.Stderr=io.Discard
+ runErr := command.Run()
+ if ctx.Err()!=nil { return fmt.Errorf("admission canceled: %w",ctx.Err()) }
+ if output.overflow { return errAdmissionProtocol }
+ exitCode:=0
+ if runErr!=nil {
+  var exited *exec.ExitError
+  if !errors.As(runErr,&exited) { return errors.New("admission executable unavailable") }
+  exitCode=exited.ExitCode()
+ }
+ response,err:=parseAdmissionResponse(exitCode,output.Bytes(),request)
+ if err!=nil { return errAdmissionProtocol }
+ if response.Outcome=="deferred" { return NewAdmissionDeferred(time.Duration(response.RetryAfterSeconds)*time.Second) }
+ return nil
+}
+
+// RunCreateProvider is the credential-safe execution boundary for opt-in
+// gateway creates. A create error is never converted into benign deferral.
+// Whether an external operation occurred must be resolved by the gateway ledger.
+func RunCreateProvider(ctx context.Context,binary string,environ []string,input []byte)([]byte,error) {
+ output:= &admissionOutput{limit:1<<20}
+ command:=exec.CommandContext(ctx,binary)
+ command.Env=environ
+ command.Stdin=bytes.NewReader(input)
+ command.Stdout=output
+ command.Stderr=io.Discard
+ err:=command.Run()
+ if ctx.Err()!=nil { return nil,fmt.Errorf("provider create canceled: %w",ctx.Err()) }
+ if output.overflow { return nil,errors.New("provider create response exceeded limit") }
+ if err!=nil {
+  var exited *exec.ExitError
+  if errors.As(err,&exited) { return nil,fmt.Errorf("provider create failed with exit code %d",exited.ExitCode()) }
+  return nil,errors.New("provider create executable unavailable")
+ }
+ return output.Bytes(),nil
+}
