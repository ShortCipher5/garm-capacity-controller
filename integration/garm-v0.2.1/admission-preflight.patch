--- /dev/null
+++ b/util/github/preparation_test.go
@@ -0,0 +1,90 @@
+package github
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner/common"
+	gh "github.com/google/go-github/v84/github"
+)
+
+func TestOriginalPreparationActualHTTPGetterRejectsUnprovenIdentityWithoutDelete(t *testing.T) {
+	for _, mode := range []string{"valid", "zero-id", "wrong-return-name", "wrong-payload-id", "wrong-payload-name", "bad-base64", "duplicate-file", "duplicate-agent", "wrong-case-agent", "nil-runner", "nil-config"} {
+		t.Run(mode, func(t *testing.T) {
+			var deletes atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodDelete {
+					deletes.Add(1)
+					w.WriteHeader(204)
+					return
+				}
+				if r.Method != http.MethodPost || !strings.HasSuffix(r.URL.Path, "/generate-jitconfig") {
+					t.Errorf("unexpected fixture request %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(404)
+					return
+				}
+				runner := &gh.Runner{ID: gh.Int64(42), Name: gh.String("planned")}
+				file := `{"agentId":42,"agentName":"planned"}`
+				switch mode {
+				case "zero-id":
+					runner.ID = gh.Int64(0)
+				case "wrong-return-name":
+					runner.Name = gh.String("unrelated")
+				case "wrong-payload-id":
+					file = `{"agentId":99,"agentName":"planned"}`
+				case "wrong-payload-name":
+					file = `{"agentId":42,"agentName":"other"}`
+				case "duplicate-agent":
+					file = `{"agentId":42,"agentId":42,"agentName":"planned"}`
+				case "wrong-case-agent":
+					file = `{"AgentId":42,"agentName":"planned"}`
+				case "nil-runner":
+					runner = nil
+				}
+				encodedFile := base64.StdEncoding.EncodeToString([]byte(file))
+				outer, _ := json.Marshal(map[string]string{".runner": encodedFile})
+				if mode == "duplicate-file" {
+					outer = []byte(`{".runner":"` + encodedFile + `",".runner":"` + encodedFile + `"}`)
+				}
+				encoded := base64.StdEncoding.EncodeToString(outer)
+				if mode == "bad-base64" {
+					encoded = "private-malformed-secret"
+				}
+				response := gh.JITRunnerConfig{Runner: runner, EncodedJITConfig: &encoded}
+				if mode == "nil-config" {
+					response.EncodedJITConfig = nil
+				}
+				_ = json.NewEncoder(w).Encode(response)
+			}))
+			defer server.Close()
+			client := gh.NewClient(server.Client())
+			endpoint, _ := url.Parse(server.URL + "/")
+			client.BaseURL = endpoint
+			g := &githubClient{ActionsService: client.Actions, repo: client.Repositories, org: client.Organizations, enterprise: client.Enterprise, rateLimit: client.RateLimit, cli: client, entity: params.ForgeEntity{ID: "fixture", Owner: "owner", Name: "repo", EntityType: params.ForgeEntityTypeRepository}}
+			config, runner, err := g.GetEntityJITConfig(common.WithOriginalPreparation(context.Background()), "planned", params.Pool{}, nil)
+			if mode == "valid" {
+				if err != nil || runner.GetID() != 42 || len(config) != 1 {
+					t.Fatal("valid original identity rejected", err)
+				}
+			} else {
+				if err == nil || len(config) != 0 || runner != nil {
+					t.Fatal("unproven original identity escaped")
+				}
+				if strings.Contains(err.Error(), "secret") {
+					t.Fatal("private payload leaked")
+				}
+			}
+			if deletes.Load() != 0 {
+				t.Fatal("unproven registration was destructively cleaned up")
+			}
+		})
+	}
+}
